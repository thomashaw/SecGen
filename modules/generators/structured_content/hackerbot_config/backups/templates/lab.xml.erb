<%
  require 'json'
  require 'securerandom'
  require 'digest/sha1'
  require 'fileutils'
  require 'erb'
  require 'shellwords'
  require 'base64'

  if self.accounts.empty?
    abort('Sorry, you need to provide an account')
  end

  $first_account = JSON.parse(self.accounts.first)
  $second_account = JSON.parse(self.accounts[1])

  $files = []
  $log_files = []
  if $second_account.key?("leaked_filenames") &&  $second_account['leaked_filenames'].size > 0
    $files = $second_account['leaked_filenames']
    $log_files = $second_account['leaked_filenames'].grep(/log/)
  end

  if $files.empty?
    $files = ['myfile', 'afile', 'filee', 'thefile']
  end
  if $log_files.empty?
    $log_files = ['log', 'thelog', 'logs', 'frogonalog']
  end

  $main_user = $first_account['username'].to_s
  $second_user = $second_account['username'].to_s
  $example_file = "/home/#{$second_user}/#{$files.sample}"
  $example_dir = "/home/#{$second_user}/personal_secrets/"

  $server_ip = self.server_ip.first
  $root_password = self.root_password
  $flags = self.flags

  REQUIRED_FLAGS = 10
  while $flags.length < REQUIRED_FLAGS
    $flags << "flag{#{SecureRandom.hex}}"
    Print.err "Warning: Not enough flags provided to hackerbot_config generator, some flags won't be tracked/marked!"
  end

  # ---------------------------------------------------------------------------------------------
  # Where things live
  # ---------------------------------------------------------------------------------------------
  $H = "/home/#{$main_user}"           # YOURUSER's home on the backup_server (backups go here)
  $S = "/home/#{$second_user}"         # SECONDUSER's home on the desktop (what is backed up)
  $bin_dir = "remote-bin-backup-#{SecureRandom.hex(2)}"
  $full  = "#{$H}/remote-rsync-full-backup"
  $diff1 = "#{$H}/remote-rsync-differential1"
  $diff2 = "#{$H}/remote-rsync-differential2"
  $incr1 = "#{$H}/remote-rsync-incremental1"
  $incr2 = "#{$H}/remote-rsync-incremental2"

  # ---------------------------------------------------------------------------------------------
  # The four "SECONDUSER makes changes" steps (attacks 3, 5, 7, 9). Contents and mtimes are fixed at
  # build time, so applying a step is idempotent: "goto N" + "ready" puts SECONDUSER's files back
  # exactly as they were at that step (size+mtime identical, so --compare-dest behaves the same).
  # Each step owns one marker file the checks look for; notes and logs/log2 change every step.
  # ---------------------------------------------------------------------------------------------
  $first_notes = SecureRandom.hex(2)
  $hidden_flag = $flags.pop
  $rand_diff2 = SecureRandom.hex(2)
  $rand2 = SecureRandom.hex(2)
  $rand3 = SecureRandom.hex(2)
  $steps = [3, 5, 7, 9]
  $step_file = { 3 => 'personal_secrets/flag', 5 => 'personal_secrets/really_not_a_flag',
                 7 => "personal_secrets/#{$rand2}", 9 => 'personal_secrets/nothing_much' }
  $step_content = { 3 => $hidden_flag, 5 => $rand_diff2, 7 => $rand2, 9 => $rand3 }
  $notes = { 3 => ["Note to self: drink more water #{$first_notes}"],
             5 => ["Note to self: drink more water #{$first_notes}", 'Dont forget the milk'],
             7 => ["Buy eggs #{$rand2}"],
             9 => ["Buy batteries #{$rand3}"] }
  $log2 = { 3 => ['Beep boop beep'],
            5 => ['Beep boop beep', 'Beep boop beep'],
            7 => ['Beep boop beep', 'Beep boop beep', 'Beep boop beep beep'],
            9 => ['Beep boop beep', 'Beep boop beep', 'Beep boop beep beep', 'Beep boop beep beep'] }
  t0 = Time.now.to_i - (Time.now.to_i % 3600)
  $mtime = { 3 => t0 + 600, 5 => t0 + 1200, 7 => t0 + 1800, 9 => t0 + 2400 }
  $step_label = { 3 => 'changes-from-step-3', 5 => 'changes-from-step-5', 7 => 'changes-from-step-7',
                  9 => 'changes-from-step-9' }

  # ---------------------------------------------------------------------------------------------
  # Helpers. Every attack runs one pre_shell on the hackerbot_server (get_shell false); scripts are
  # shipped to the target base64-encoded (no quoting/XML escaping problems) and run with bash.
  # ---------------------------------------------------------------------------------------------
  $ssh = 'ssh -i /opt/hackerbot/keys/id_rsa -oStrictHostKeyChecking=no -oBatchMode=yes'
  $desktop = 'root@{{chat_ip_address}}'
  $backup = "root@#{$server_ip}"
  $stash = "/root/.hb_backups_lab/originals-#{$second_user}.tgz"

  def q(s)
    Shellwords.escape(s)
  end

  # ssh client warnings (e.g. OpenSSH 10's "** WARNING: connection is not using a post-quantum key exchange"
  # when talking to an older sshd) would otherwise show up in the student's FYI output; our scripts never
  # print lines starting with "** ", and real connection errors don't either, so they still reach the conditions.
  $nowarn = "| grep -v '^\\*\\* '"

  # Our scripts always exit 0, so a non-zero ssh exit means we never got there (VM down, ssh refused...):
  # print UNREACHABLE so the bot can say so, rather than misreading it as a bad backup.
  def on_host(host, script)
    "(echo #{Base64.strict_encode64(script)} | base64 -d | #{$ssh} #{host} bash -s 2>&1; r=$?; " \
    "[ $r = 0 ] || echo \"UNREACHABLE (ssh exit $r)\") #{$nowarn}"
  end

  def xml(s)
    s.encode(xml: :text)
  end

  # A bash function that checks one backup (or the restored home dir) and prints one line per item:
  #   OK <label> | MISSING <label> | UNEXPECTED <label> | NODIR <path>, then RESULT PASS|RESULT FAIL.
  # stderr is discarded, so random names in paths can never leak into what the conditions match.
  def check_fn(fname, root, items, tag: '', structure: true)
    r = "#{root}/#{$second_user}"
    out = ["#{fname}() {", '  f=0']
    if structure
      # SECONDUSER's files sitting directly in the backup dir = "copied the contents, not the directory"
      top = ($files.map { |p| "[ -e #{q(root + '/' + p)} ]" } + ["[ -d #{q(root + '/personal_secrets')} ]"]).join(' || ')
      out << "  if #{top}; then echo '#{tag}UNEXPECTED contents-at-top'; echo '#{tag}RESULT FAIL'; return 1; fi"
      out << "  if [ ! -d #{q(r)} ]; then echo '#{tag}NODIR #{r}'; echo '#{tag}RESULT FAIL'; return 1; fi"
    end
    out << "  if [ -d #{q(r + '/' + $second_user)} ]; then echo '#{tag}UNEXPECTED nested'; f=1; fi"
    items.each do |kind, label, arg, extra|
      case kind
      when :all_present
        t = arg.map { |p| "[ -e #{q(r + '/' + p)} ]" }.join(' && ')
        out << "  if #{t}; then echo '#{tag}OK #{label}'; else echo '#{tag}MISSING #{label}'; f=1; fi"
      when :none_present
        t = arg.map { |p| "[ -e #{q(r + '/' + p)} ]" }.join(' || ')
        out << "  if #{t}; then echo '#{tag}UNEXPECTED #{label}'; f=1; else echo '#{tag}OK #{label} (not included)'; fi"
      when :equals
        want = extra.map { |l| q(l) }.join(' ')
        out << "  if [ \"$(cat #{q(r + '/' + arg)} 2>/dev/null)\" = \"$(printf '%s\\n' #{want})\" ]; then echo '#{tag}OK #{label}'; else echo '#{tag}MISSING #{label}'; f=1; fi"
      when :owned
        out << "  if [ -z \"$(find #{q(r)} ! -user #{$second_user} -print -quit 2>/dev/null)\" ]; then echo '#{tag}OK #{label}'; else echo '#{tag}MISSING #{label}'; f=1; fi"
      end
    end
    out << "  if [ $f = 0 ]; then echo '#{tag}RESULT PASS'; return 0; fi; echo '#{tag}RESULT FAIL'; return 1"
    out << '}'
    out.join("\n")
  end

  # Expected contents of each backup, in terms of the step marker files
  def backup_items(present_steps, absent_steps)
    items = [[:none_present, 'original-files', $files]]
    present_steps.each { |s| items << [:all_present, $step_label[s], [$step_file[s]]] }
    absent_steps.each { |s| items << [:none_present, $step_label[s], [$step_file[s]]] }
    items
  end
  # Each backup must hold exactly the right steps' changes: taken too late it would hold the next step's too
  # (e.g. a late differential1 holds step 5's notes, and attack 13 then has no copy of the first notes).
  $full_items  = [[:all_present, 'original-files', $files]]
  $diff1_items = backup_items([3], [5])
  $diff2_items = backup_items([3, 5], [7])
  $incr1_items = backup_items([7], [3, 5, 9])
  $incr2_items = backup_items([9], [3, 5, 7])

  # needs: backups this one is based on (its --compare-dest dirs), checked first so a student who skipped
  # ahead is told which earlier backup to take, instead of a confusing "wrong contents" message
  def check_script(root, items, needs = [])
    pre = needs.map do |label, dir|
      "if [ ! -d #{q(dir + '/' + $second_user)} ]; then echo 'NEEDS #{label}'; echo 'RESULT FAIL'; exit 0; fi"
    end
    check_fn('chk', root, items) + "\n" + pre.join("\n") + "\nchk\nexit 0\n"
  end

  # Script that puts SECONDUSER's step files into the state of the given step
  def stage_script(step)
    s = ["S=#{q($S)}", 'mkdir -p "$S/logs" "$S/personal_secrets"']
    $steps.each do |k|
      f = "\"$S\"/#{q($step_file[k])}"
      if k <= step
        s << "printf '%s\\n' #{q($step_content[k])} > #{f}; chown #{$second_user}:#{$second_user} #{f}; touch -d @#{$mtime[k]} #{f}"
      else
        s << "rm -f #{f}"
      end
    end
    s << "printf '%s\\n' #{$notes[step].map { |l| q(l) }.join(' ')} > \"$S/notes\""
    s << "printf '%s\\n' #{$log2[step].map { |l| q(l) }.join(' ')} > \"$S/logs/log2\""
    s << "chown #{$second_user}:#{$second_user} \"$S/notes\" \"$S/logs/log2\""
    s << "touch -d @#{$mtime[step]} \"$S/notes\" \"$S/logs/log2\""
    s << "echo STAGE-#{step}-APPLIED"
    s.join("\n") + "\n"
  end

  # pre_shell for a change step: on first use, stash SECONDUSER's original files on the hackerbot_server
  # (students can't reach it); every time, put the originals back, then apply the step's state.
  def stage_pre_shell(step)
    d = "#{$ssh} #{$desktop}"
    "mkdir -p #{File.dirname($stash)}; O=#{$stash}; " \
    "if [ ! -s $O ]; then #{d} 'test -d #{$S}/trade_secrets && tar -C /home -czf - #{$second_user}' > $O.tmp 2>/dev/null; " \
    "if [ -s $O.tmp ]; then mv $O.tmp $O; else rm -f $O.tmp; fi; fi; " \
    "if [ -s $O ]; then #{d} 'tar -C /home -xzf - && echo ORIGINALS-RESTORED' < $O 2>&1 #{$nowarn}; else echo ORIGINALS-UNAVAILABLE; fi; " +
    on_host($desktop, stage_script(step))
  end

  # attack 11: only delete once every backup needed afterwards checks out: full, differential2, incremental1 and
  # incremental2 for the restore (attack 12), and differential1, the only copy of notes' first version (attack 13)
  $gate_script = [
    check_fn('chk_full', $full, $full_items, tag: '[full backup] '),
    check_fn('chk_diff1', $diff1, $diff1_items, tag: '[differential1] '),
    check_fn('chk_diff2', $diff2, $diff2_items, tag: '[differential2] '),
    check_fn('chk_incr1', $incr1, $incr1_items, tag: '[incremental1] '),
    check_fn('chk_incr2', $incr2, $incr2_items, tag: '[incremental2] '),
    'g=0; chk_full || g=1; chk_diff1 || g=1; chk_diff2 || g=1; chk_incr1 || g=1; chk_incr2 || g=1',
    'if [ $g = 0 ]; then echo GATE-PASS; else echo GATE-FAIL; fi',
    'exit 0'
  ].join("\n") + "\n"
  $wipe_script = "rm -rf #{q($S)}/*; echo WIPED\n"

  $restore_items = [[:all_present, 'original-files', $files]] +
                   $steps.map { |k| [:all_present, $step_label[k], [$step_file[k]]] } +
                   [[:equals, 'notes-latest-version', 'notes', $notes[9]], [:owned, 'ownership']]

  $notes_script = "n=\"$(cat #{q($S + '/notes')} 2>/dev/null)\"\n" +
                  $steps.map { |k| "if [ \"$n\" = \"$(printf '%s\\n' #{$notes[k].map { |l| q(l) }.join(' ')})\" ]; then echo NOTES-STEP-#{k}; exit 0; fi" }.join("\n") +
                  "\nif [ -z \"$n\" ]; then echo NOTES-MISSING; else echo NOTES-OTHER; fi\n"

  $retry_hint = "If your files are in a mess, say 'goto 11' then 'ready' and I'll delete them again so you can start the restore from scratch."
  $unreach_backup = "I couldn't connect to the backup_server (#{$server_ip}) to check -- is it running? (The FYI line shows the ssh error.) Say 'ready' again once it's up."
  $unreach_desktop = "I couldn't connect to your desktop -- is its SSH server running? (The FYI line shows the ssh error.) Say 'ready' again once it's up."

  # fallback when the check output matches none of the specific conditions
  def odd_output(where)
    ":( That's not what I expected in #{where} -- the FYI lines above show what I checked (anything MISSING or UNEXPECTED is the problem). ssh to the backup_server and have a look with ls -R."
  end

  def get_binding
    binding
  end
-%>
<?xml version="1.0"?>

<hackerbot
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.github/cliffe/SecGen/hackerbot">
<!--<hackerbot xmlns="http://www.github/cliffe/SecGen/hackerbotz"-->

	<name>Hackerbot</name>

	<AIML_chatbot_rules>config/AIML</AIML_chatbot_rules>

	<!--Method for gaining shell access, can be overwritten per-attack-->
	<!--<get_shell>bash</get_shell>-->
	<get_shell>ssh -i /opt/hackerbot/keys/id_rsa -oStrictHostKeyChecking=no root@{{chat_ip_address}} /bin/bash</get_shell>

	<messages>
    <show_attack_numbers />

		<greeting>Hey, today I'm your boss of sorts... Work with me and I'll pay you in flags :) These tasks need to be done in order. If a backup goes wrong because <%= $second_user %>'s files have moved on, say 'goto' a change step (3, 5, 7 or 9) then 'ready', and I'll put their files back exactly as they were at that step.</greeting>

		<!--Must provide alternatives for each message-->
		<say_ready>When you are ready, simply say 'ready'.</say_ready>
		<say_ready>'Ready'?</say_ready>
		<next>Ok, I'll do what I can to move things along...</next>
		<next>Moving things along to the next one...</next>
		<previous>Ok, I'll do what I can to back things up...</previous>
		<previous>Ok, backing up.</previous>
		<goto>Ok, skipping it along.</goto>
		<goto>Let me see what I can do to goto that job.</goto>
		<last_attack>That was the last one for now. You can rest easy, until next time... (End.)</last_attack>
		<last_attack>That was the last one. Game over?</last_attack>
		<first_attack>You are back to the beginning!</first_attack>
		<first_attack>This is where it all began.</first_attack>
		<getting_shell>Ok. Let me take a look...</getting_shell>
		<getting_shell>Here we go...</getting_shell>
		<got_shell>I am in to your system.</got_shell>
		<got_shell>I have shell.</got_shell>
		<repeat>Let me know when you are 'ready', if you want to move on say 'next', or 'previous' and I'll move things along.</repeat>
		<repeat>Say 'ready', 'next', or 'previous'.</repeat>

		<!--Single responses:-->
		<help>I am waiting for you to say 'ready', 'next', 'previous', 'list', 'goto *X*', or 'answer *X*'</help>
		<say_answer>Say "The answer is X".</say_answer>
		<no_quiz>There is no question to answer</no_quiz>
		<correct_answer>Correct</correct_answer>
		<incorrect_answer>Incorrect</incorrect_answer>
		<invalid>That's not possible.</invalid>
		<non_answer>Wouldn't you like to know.</non_answer>

		<!--can be overwritten per-attack-->
		<shell_fail_message>Oh no. Failed to get shell... You need to let us in.</shell_fail_message>
	</messages>

	<tutorial_info>
		<title>Backing Up and Recovering from Disaster: SSH/SCP, Deltas, and Rsync</title>
		<tutorial><%= ERB.new(File.read self.templates_path + 'intro.md.erb').result(self.get_binding) %></tutorial>
		<footer>
<%= File.read self.templates_path + 'resources.md.erb' %>

<%= File.read self.templates_path + 'license.md.erb' %>

Randomised instance generated by [SecGen](http://github.com/cliffe/SecGen) (<%= Time.new.to_s %>)
		</footer>

		<provide_tutorial>true</provide_tutorial>

	</tutorial_info>

	<!-- ============================== 1: scp /usr/bin ============================== -->
	<attack>
		<prompt>Use scp to copy the desktop's /usr/bin/ directory to the backup_server, so that <%= $server_ip %>:<%= $H %>/<%= $bin_dir %>/ contains the backed up bin/ directory.</prompt>

		<pre_shell><%= xml(on_host($backup, "R=#{q($H + '/' + $bin_dir)}\nif [ ! -d \"$R\" ]; then echo 'NODIR #{$H}/#{$bin_dir}'\nelif [ -e \"$R/bin/ls\" ] && [ -e \"$R/bin/mkdir\" ]; then echo 'OK bin/ls bin/mkdir'; echo 'RESULT PASS'\nelif [ -e \"$R/ls\" ]; then echo 'UNEXPECTED contents-without-bin'; echo 'RESULT FAIL'\nelse echo 'MISSING bin/ls'; echo 'RESULT FAIL'; fi\n")) %></pre_shell>
		<get_shell>false</get_shell>
		<condition>
			<output_matches>RESULT PASS</output_matches>
			<message>:) Well done! <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<condition>
			<output_matches>UNREACHABLE</output_matches>
			<message>:( <%= $unreach_backup %></message>
		</condition>
		<condition>
			<output_matches>NODIR</output_matches>
			<message>:( There's no <%= $H %>/<%= $bin_dir %> on the backup_server yet. Create that directory first (ssh to the backup_server and mkdir it), then scp -r /usr/bin into it. (If scp said 'realpath ... No such file' or 'path canonicalization failed', that's why: the destination doesn't exist yet. And without a trailing slash, scp would create it *as* the copy, with no bin/ directory inside.)</message>
		</condition>
		<condition>
			<output_matches>UNEXPECTED contents-without-bin</output_matches>
			<message>:( You copied the *contents* of bin straight into <%= $bin_dir %>/, not a bin/ directory inside it. That's what scp does when the destination doesn't exist yet. Delete <%= $bin_dir %> on the backup_server, mkdir it, then scp -r the directory into it.</message>
		</condition>
		<else_condition>
			<message>:( <%= $bin_dir %> exists, but there's no bin/ls in it. Have a look at what you copied there (ssh to the backup_server and ls it).</message>
		</else_condition>
	</attack>

	<!-- ============================== 2: full backup ============================== -->
	<attack>
		<!-- topic: Rsync-->
		<prompt>It's your job to set up remote backups for <%= $second_user %> (a user on your system). Use rsync to create a full (epoch) remote backup of /home/<%= $second_user %> from your desktop system to the backup_server, so it ends up in <%= $server_ip %>:<%= $full %>/<%= $second_user %> -- keeping <%= $second_user %>'s file ownership (-M--fake-super, see the lab sheet).</prompt>

		<pre_shell><%= xml(on_host($backup, check_script($full, $full_items))) %></pre_shell>
		<get_shell>false</get_shell>
		<condition>
			<output_matches>UNREACHABLE</output_matches>
			<message>:( <%= $unreach_backup %></message>
		</condition>
		<condition>
			<output_matches>RESULT PASS</output_matches>
			<message>:) Well done! <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<condition>
			<output_matches>UNEXPECTED contents-at-top</output_matches>
			<message>:( You copied the *contents* of /home/<%= $second_user %> straight into remote-rsync-full-backup/, instead of a <%= $second_user %>/ directory inside it. With rsync, /home/<%= $second_user %> (no trailing slash) copies the directory; /home/<%= $second_user %>/ copies only what's in it. Delete it on the backup_server and try again.</message>
		</condition>
		<condition>
			<output_matches>UNEXPECTED nested</output_matches>
			<message>:( Your backup is nested one level too deep: remote-rsync-full-backup/<%= $second_user %>/<%= $second_user %>/. Give rsync the *parent* directory (.../remote-rsync-full-backup/) as the destination -- it creates <%= $second_user %>/ inside it. Delete it on the backup_server and try again.</message>
		</condition>
		<condition>
			<output_matches>NODIR</output_matches>
			<message>:( I can't find <%= $full %>/<%= $second_user %> on the backup_server. Check the destination path. (If rsync said 'mkdir ... failed: No such file or directory', the parent directory didn't exist: rsync only creates the last directory of the destination.)</message>
		</condition>
		<condition>
			<output_matches>MISSING original-files</output_matches>
			<message>:( Some of <%= $second_user %>'s files aren't in your backup. Did you run rsync with sudo? Some of their files are private to them, so without sudo rsync can't read everything (look for 'Permission denied' in rsync's output).</message>
		</condition>
		<else_condition>
			<message><%= odd_output("#{$full}/#{$second_user}") %></message>
		</else_condition>

		<tutorial><%= ERB.new(File.read self.templates_path + 'rsync.md.erb').result(self.get_binding) %></tutorial>
	</attack>

	<!-- ============================== 3: changes (step 3) ============================== -->
	<attack>
		<prompt>Step 3: the <%= $second_user %> user is about to make some changes to their files. Say 'ready' to let them.</prompt>

		<pre_shell><%= xml(stage_pre_shell(3)) %></pre_shell>
		<get_shell>false</get_shell>
		<suppress_command_output_feedback />
		<condition>
			<output_matches>UNREACHABLE</output_matches>
			<message>:( <%= $unreach_desktop %></message>
		</condition>
		<condition>
			<output_matches>STAGE-3-APPLIED</output_matches>
			<message>Ok, <%= $second_user %> has made their changes... (Hint: Keep an eye out for a flag...) Now take the differential backup, before saying 'ready' again. (You can always say 'goto 3' then 'ready' to put their files back to exactly this point.)</message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<condition>
			<output_matches>Permission denied|Operation not permitted|Read-only|No route|Connection refused|timed out</output_matches>
			<message>:( Oh no. I couldn't make <%= $second_user %>'s changes on your desktop. Is it running, and are <%= $second_user %>'s files writable?</message>
		</condition>
		<else_condition>
			<message>:( I couldn't make the step-3 changes to <%= $second_user %>'s files on your desktop (unexpected result). Check the desktop is running and that /home/<%= $second_user %> exists, then say 'ready' again.</message>
		</else_condition>
	</attack>

	<!-- ============================== 4: differential1 ============================== -->
	<attack>
		<!-- topic: Rsync differential-->
		<prompt>Create a differential backup of <%= $second_user %>'s home directory on the backup_server, so it ends up in <%= $server_ip %>:<%= $diff1 %>/<%= $second_user %>/ (just the changes since the full backup).</prompt>

		<pre_shell><%= xml(on_host($backup, check_script($diff1, $diff1_items, [['full-backup', $full]]))) %></pre_shell>
		<get_shell>false</get_shell>
		<condition>
			<output_matches>UNREACHABLE</output_matches>
			<message>:( <%= $unreach_backup %></message>
		</condition>
		<condition>
			<output_matches>RESULT PASS</output_matches>
			<message>:) Well done! <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<condition>
			<output_matches>NEEDS full-backup</output_matches>
			<message>:( Your full backup (<%= $full %>/<%= $second_user %>) isn't on the backup_server, and a differential is only the changes compared with it. Say 'goto 2' and do the full backup first -- it must be taken *before* step 3's changes, so then say 'goto 3' and 'ready' again before this differential.</message>
		</condition>
		<condition>
			<output_matches>UNEXPECTED contents-at-top</output_matches>
