<% require 'json'
	 require 'securerandom'
	 require 'fileutils'
	 require 'erb'

	 if self.accounts.empty?
		 abort('Sorry, you need to provide an account')
	 end

	 $first_account = JSON.parse(self.accounts.first)

	 $main_user = $first_account['username'].to_s

	 $root_password = self.root_password
	 $flags = self.flags

	 REQUIRED_FLAGS = 8
	 while $flags.length < REQUIRED_FLAGS
		 $flags << "flag{#{SecureRandom.hex}}"
		 Print.err "Warning: Not enough flags provided to hackerbot_config generator, some flags won't be tracked/marked!"
	 end

	 # IP addresses - must match scenario.xml datastore
	 $gateway_lan_ip    = '10.0.1.1'
	 $desktop_ip        = '10.0.1.10'
	 $gateway_dmz_ip    = '10.0.2.1'
	 $webserver_ip      = '10.0.2.10'
	 $gateway_server_ip = '10.0.3.1'
	 $server_ip         = '10.0.3.10'

	 # Randomised values for challenges
	 $new_desktop_ip = "10.0.1.#{rand(50..99)}"

	 # regenerate bytes that include "D" because they render as smiley faces :D-|<
	 def printable_byte
		 loop do
			 b = rand(256)
			 return b unless ("%02X" % b).include?("D")
		 end
	 end

	 $new_mac = "00:AB:CD:%02X:%02X:%02X" % [printable_byte, printable_byte, printable_byte]

	 def get_binding
		 binding
	 end %>

<?xml version="1.0"?>

<hackerbot
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.github/cliffe/SecGen/hackerbot">

	<name>Hackerbot</name>

	<AIML_chatbot_rules>config/AIML</AIML_chatbot_rules>

	<get_shell>sshpass -p <%= $root_password %> ssh -oStrictHostKeyChecking=no root@<%= $desktop_ip %> /bin/bash</get_shell>

	<messages>
		<show_attack_numbers />

		<greeting>Welcome to the Network Security Fundamentals lab. I'll be setting you challenges to test your networking and security skills. Complete them and I'll give you flags. Let's get started!</greeting>

		<say_ready>Let me know when you are 'ready', if you want to move on to another challenge, say 'next', or 'previous' and I'll move things along.</say_ready>
		<say_ready>When you are ready, simply say 'ready'.</say_ready>
		<say_ready>'Ready'?</say_ready>
		<say_ready>Better hurry... Let me know when you're 'ready'.</say_ready>
		<next>Ok, moving to the next challenge...</next>
		<next>Next challenge...</next>
		<next>Ok, onwards...</next>
		<previous>Ok, going back...</previous>
		<previous>Ok, previous challenge...</previous>
		<previous>Ok, backing up.</previous>
		<goto>Ok, skipping ahead.</goto>
		<goto>Let me see what I can do to goto that challenge.</goto>
		<last_attack>That was the last challenge for now. Well done! (End.)</last_attack>
		<last_attack>That was the last challenge. Great work!</last_attack>
		<first_attack>You are back to the beginning!</first_attack>
		<first_attack>This is where it all began.</first_attack>
		<getting_shell>Ok. Checking your configuration...</getting_shell>
		<getting_shell>Verifying...</getting_shell>
		<getting_shell>Let me check that...</getting_shell>
		<getting_shell>Here we go...</getting_shell>
		<got_shell>Connected to your system.</got_shell>
		<got_shell>Access confirmed.</got_shell>
		<got_shell>We have shell.</got_shell>
		<repeat>Let me know when you are 'ready', if you want to move on, say 'next', or 'previous'.</repeat>
		<repeat>Say 'ready', 'next', or 'previous'.</repeat>

		<help>I am waiting for you to say 'ready', 'next', 'previous', 'list', 'goto *X*', or 'answer *X*'</help>
		<say_answer>Say "The answer is X".</say_answer>
		<no_quiz>There is no question to answer</no_quiz>
		<correct_answer>Correct</correct_answer>
		<incorrect_answer>Incorrect</incorrect_answer>
		<invalid>That's not possible.</invalid>
		<non_answer>Wouldn't you like to know.</non_answer>

		<shell_fail_message>Oh no. Failed to connect... Check your network configuration.</shell_fail_message>
	</messages>

	<tutorial_info>
		<title>Network Security Fundamentals: Network Design, Segmentation, NAT and DMZ</title>
		<tutorial><%= ERB.new(File.read self.templates_path + 'intro.md.erb').result(self.get_binding) %></tutorial>
		<footer>
<%= ERB.new(File.read self.templates_path + 'resources.md.erb').result(self.get_binding) %>
<%= ERB.new(File.read self.templates_path + 'license.md.erb').result(self.get_binding) %>
Randomised instance generated by [SecGen](http://github.com/cliffe/SecGen) (<%= Time.new.to_s %>)
		</footer>

		<provide_tutorial>true</provide_tutorial>

	</tutorial_info>


	<!-- =================================================================
	     SECTION 1: Network Reconnaissance &amp; Routing
	     Theory: network design, routing, IP forwarding, SSH hopping
	     Challenges 1-2: Connect the network, retrieve webserver flag
	     ================================================================= -->

	<attack>
		<prompt>All four VMs are on separate segments but have no default routes configured, and the gateway is not forwarding traffic. Use SSH to interact with the systems to configure routing and IP forwarding so that all VMs can communicate across segments. You may find some flags along the way. Say 'ready' when the network is fully connected.</prompt>

			<post_command>ping -c 1 -W 3 <%= $webserver_ip %> > /dev/null 2>/dev/null; status1=$?; ping -c 1 -W 3 <%= $server_ip %> > /dev/null 2>/dev/null; status2=$?; echo $status1$status2</post_command>
			<condition>
				<output_matches>00</output_matches>
				<message>:) The network is fully connected! Your desktop can reach both the webserver and the server across segments.</message>
				<trigger_quiz />
			</condition>
			<else_condition>
				<message>:( The desktop cannot reach all VMs (status: webserver=$status1, server=$status2, where 0=reachable, 1=unreachable). Make sure you have: (1) enabled IP forwarding on the gateway, (2) set default routes on the desktop, webserver, and server, all pointing at the gateway's IP on their local segment.</message>
			</else_condition>
			<tutorial>
				<%= ERB.new(File.read self.templates_path + 'network_design.md.erb').result(self.get_binding) %>

				---

				<%= ERB.new(File.read self.templates_path + 'reconnaissance_routing.md.erb').result(self.get_binding) %>
			</tutorial>
	</attack>


	<!-- =================================================================
	     SECTION 2: IP and MAC Address Fundamentals
	     Theory: IP addresses, MAC addresses, spoofing implications
	     Challenges 3-4: Change IP, change MAC
	     ================================================================= -->

	<attack>
		<prompt>Change your desktop's IP address to <%= $new_desktop_ip %>. Make sure you keep connectivity to the gateway. Say 'ready' when done.</prompt>

		<!-- TODO: Hackerbot checks:
		     1. SSH to desktop at new IP, or check ip addr show on desktop
		     2. Verify desktop can still ping gateway
		-->

		<post_command>sshpass -p <%= $root_password %> ssh -oStrictHostKeyChecking=no root@<%= $new_desktop_ip %> 'ip addr show ens19 | grep "<%= $new_desktop_ip %>" &amp;&amp; ping -c 1 <%= $gateway_lan_ip %> > /dev/null 2>&amp;1 &amp;&amp; echo SUCCESS || echo FAIL'</post_command>
		<condition>
			<output_matches>SUCCESS</output_matches>
			<message>:) Your desktop is responding at <%= $new_desktop_ip %> and can reach the gateway. <%= $flags.pop %></message>
			<trigger_next_attack />
		</condition>
		<else_condition>
			<message>:( Could not verify your desktop at <%= $new_desktop_ip %> or it cannot reach the gateway. Check your configuration.</message>
		</else_condition>

		<tutorial><%= ERB.new(File.read self.templates_path + 'ip_mac_fundamentals.md.erb').result(self.get_binding) %></tutorial>
	</attack>

	<attack>
		<prompt>Change your desktop's MAC address to <%= $new_mac %>. Make sure you maintain connectivity. Say 'ready' when done.</prompt>

		<!-- TODO: Hackerbot checks:
		     1. SSH to desktop, check ip link show ens19 contains new MAC
		     2. Verify connectivity
		-->

		<post_command>sshpass -p <%= $root_password %> ssh -oStrictHostKeyChecking=no root@<%= $new_desktop_ip %> 'ip link show ens19 | grep -i "<%= $new_mac.downcase %>" &amp;&amp; echo SUCCESS || echo FAIL'</post_command>
		<condition>
			<output_matches>SUCCESS</output_matches>
			<message>:) MAC address changed successfully. <%= $flags.pop %></message>
			<trigger_next_attack />
		</condition>
		<else_condition>
			<message>:( Could not verify the MAC address change. Expected <%= $new_mac %> on ens19. Check with: ip link show ens19</message>
		</else_condition>
		<tutorial>
<%= ERB.new(File.read self.templates_path + 'firewall_concepts.md.erb').result(self.get_binding) %>

---

<%= ERB.new(File.read self.templates_path + 'iptables_practical.md.erb').result(self.get_binding) %>
		</tutorial>
	</attack>

	<attack>
		<prompt>Now fix the misconfiguration. Add an iptables rule to the gateway that blocks the webserver from reaching that service on the server, while ensuring the desktop can still access it. Say 'ready' when done.</prompt>

		<!-- TODO: Hackerbot checks:
		     1. SSH to webserver, try nc to server on misconfigured port - should fail
		     2. SSH to desktop, try nc to server on same port - should succeed
		-->

		<post_command>sshpass -p <%= $root_password %> ssh -oStrictHostKeyChecking=no root@<%= $webserver_ip %> 'timeout 3 nc -z <%= $server_ip %> MISCONFIGURED_PORT 2>&amp;1 &amp;&amp; echo STILL_OPEN || echo BLOCKED'</post_command>
		<condition>
			<output_matches>BLOCKED</output_matches>
			<message>:) The misconfiguration is fixed - the webserver can no longer reach that service. <%= $flags.pop %></message>
			<trigger_next_attack />
		</condition>
		<condition>
			<output_matches>STILL_OPEN</output_matches>
			<message>:( The webserver can still reach the service on the server. Check your iptables rule on the gateway.</message>
		</condition>
		<else_condition>
			<message>:( Something went wrong with the check. Make sure the network is still connected.</message>
		</else_condition>
		<tutorial><%= ERB.new(File.read self.templates_path + 'nat.md.erb').result(self.get_binding) %></tutorial>
	</attack>


	<!-- =================================================================
	     SECTION 5: DMZ Concepts &amp; Segmentation Policy
	     Theory: DMZ traffic flow principles
	     Challenge 8: Enforce segmentation policy
	     ================================================================= -->

	<attack>
		<prompt>Enforce a proper segmentation policy on the gateway using iptables: (1) the webserver must NOT be able to initiate any new TCP connections to the server, (2) the desktop must still reach both, (3) the server must still be able to send response traffic to the webserver for established connections. Say 'ready' when done.</prompt>

		<post_command>RESULT=""; WS_TO_SRV=$(sshpass -p <%= $root_password %> ssh -oStrictHostKeyChecking=no root@<%= $webserver_ip %> 'timeout 3 nc -z <%= $server_ip %> 22 2>&amp;1 &amp;&amp; echo OPEN || echo BLOCKED'); DT_TO_SRV=$(sshpass -p <%= $root_password %> ssh -oStrictHostKeyChecking=no root@<%= $new_desktop_ip %> 'timeout 3 nc -z <%= $server_ip %> 22 2>&amp;1 &amp;&amp; echo OPEN || echo BLOCKED'); DT_TO_WS=$(sshpass -p <%= $root_password %> ssh -oStrictHostKeyChecking=no root@<%= $new_desktop_ip %> 'timeout 3 nc -z <%= $webserver_ip %> 80 2>&amp;1 &amp;&amp; echo OPEN || echo BLOCKED'); if [ "$WS_TO_SRV" = "BLOCKED" ] &amp;&amp; [ "$DT_TO_SRV" = "OPEN" ] &amp;&amp; [ "$DT_TO_WS" = "OPEN" ]; then echo "ALL_PASS"; else echo "FAIL ws_to_srv=$WS_TO_SRV dt_to_srv=$DT_TO_SRV dt_to_ws=$DT_TO_WS"; fi</post_command>
		<condition>
			<output_matches>ALL_PASS</output_matches>
			<message>:) Excellent! Your segmentation policy is correctly enforced. The DMZ cannot reach the server zone, but the desktop can reach both. <%= $flags.pop %></message>
			<trigger_next_attack />
		</condition>
		<condition>
			<output_matches>FAIL</output_matches>
			<message>:( Not all conditions are met. Check: webserver -> server should be BLOCKED, desktop ->server should be OPEN, desktop ->webserver should be OPEN. Review your iptables rules on the gateway.</message>
		</condition>
		<else_condition>
			<message>:( Something went wrong with the verification. Make sure all VMs are reachable.</message>
		</else_condition>

		<tutorial><%= ERB.new(File.read self.templates_path + 'dmz_concepts.md.erb').result(self.get_binding) %></tutorial>
	</attack>

</hackerbot>