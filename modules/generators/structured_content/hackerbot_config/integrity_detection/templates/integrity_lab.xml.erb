	<attack>
		<!-- #8 swap two binaries in /usr/bin. ONE staged challenge (self-inverse swap). -->
		<prompt>Two binaries are about to be swapped in /usr/bin. Say 'ready' and I'll first get your system to a known-good state.</prompt>
		<pre_shell>S=/root/.hb_swap; mkdir -p "$S"; K=/opt/hackerbot/keys/id_rsa; H=root@{{chat_ip_address}}; if [ ! -s "$S/pair" ]; then ssh -i $K -oStrictHostKeyChecking=no $H 'find /usr/bin -type f -links 1 -executable ! -name ".*" ! -name bash ! -name sh ! -name dash ! -name mv ! -name cp ! -name sudo ! -name su ! -name ssh ! -name scp ! -name sftp | sort -R | head -n 2' > "$S/pair"; fi; p1=$(sed -n 1p "$S/pair"); p2=$(sed -n 2p "$S/pair"); if [ ! -e "$S/stage" ]; then if [ -e "$S/swapped" ]; then ssh -i $K -oStrictHostKeyChecking=no $H "mv \"$p1\" \"$p1.swp\"; mv \"$p2\" \"$p1\"; mv \"$p1.swp\" \"$p2\""; rm -f "$S/swapped"; fi; touch "$S/stage"; echo PREPARED; else ssh -i $K -oStrictHostKeyChecking=no $H "mv \"$p1\" \"$p1.swp\"; mv \"$p2\" \"$p1\"; mv \"$p1.swp\" \"$p2\""; touch "$S/swapped"; rm -f "$S/stage"; echo "$p1 $p2|$p2 $p1|${p1#/usr} ${p2#/usr}|${p2#/usr} ${p1#/usr}"; fi</pre_shell>
		<get_shell>false</get_shell>
		<suppress_command_output_feedback />
		<condition>
			<output_matches>PREPARED</output_matches>
			<message>Your system is in a known-good state. Now take a baseline set of hashes of /usr/bin, then say 'ready' and I'll swap two binaries.</message>
		</condition>
		<condition>
			<output_matches>/bin/</output_matches>
			<message>Two binaries in /usr/bin have had their contents swapped. Compare a fresh set of hashes against your baseline to find both.</message>
			<trigger_quiz />
		</condition>
		<condition>
			<output_matches>No route to host|Connection refused</output_matches>
			<message>:( I couldn't reach your system.</message>
		</condition>
		<else_condition>
			<message>:( Something was not right...</message>
		</else_condition>
		<quiz>
			<question>Which two files had their contents changed? Write the two full paths separated by a space.</question>
			<answer>{{pre_shell_command_output_first_line}}</answer>
			<correct_answer_response>:) <%= $flags.pop %></correct_answer_response>
			<trigger_next_attack />
		</quiz>
	</attack>

