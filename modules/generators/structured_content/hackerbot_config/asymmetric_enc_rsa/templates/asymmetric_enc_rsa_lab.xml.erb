<%
  require 'json'
  require 'securerandom'
  require 'erb'

  if self.accounts.empty?
    abort('Sorry, you need to provide an account')
  end
  $first_account = JSON.parse(self.accounts.first)
  $main_user = $first_account['username'].to_s
  $H = "/home/#{$main_user}"

  $flags = self.flags
  REQUIRED_FLAGS = 14
  while $flags.length < REQUIRED_FLAGS
    $flags << "flag{#{SecureRandom.hex}}"
    Print.err "Warning: Not enough flags provided to hackerbot_config generator, some flags won't be tracked/marked!"
  end

  # ---------------------------------------------------------------------------------------------
  # RSA by hand (challenges 1-5): every key and message is picked at build time
  # ---------------------------------------------------------------------------------------------
  $k1 = toy_rsa_key
  $e1 = e_candidates($k1)

  $k2 = toy_rsa_key

  $k3 = toy_rsa_key
  $m3 = toy_message($k3)
  $c3 = $m3.pow($k3[:e], $k3[:n])

  $k4 = toy_rsa_key
  $m4 = toy_message($k4)
  $c4 = $m4.pow($k4[:e], $k4[:n])

  $word = self.secret_word.strip
  $word = %w[falcon harbour lantern meadow quartz saddle thistle walnut].sample unless $word =~ /\A[A-Za-z]{3,12}\z/
  $k5 = toy_rsa_key
  $ct5 = encrypt_rsa($word, $k5[:e], $k5[:n])

  # ---------------------------------------------------------------------------------------------
  # OpenSSL and chains of trust (challenges 6-12)
  # ---------------------------------------------------------------------------------------------
  def dir(n)
    "#{$H}/challenge_#{n}"
  end
  $msg7 = SecureRandom.hex(4)
  $msg8 = SecureRandom.hex(4)
  $leaf_name = "shop-#{SecureRandom.hex(3)}.example"

  # The weak intermediate CA: its P-384 private key is a small number (one of eMudhra's was 4)
  $weak_k = rand_between(5, 999)
  $ca = weak_ca($weak_k)
  $root_file = 'lab_trust_root.crt'
  $inter_file = 'lab_trust_inter.crt'

  # ---------------------------------------------------------------------------------------------
  # Key exchange (challenges 13-14)
  # ---------------------------------------------------------------------------------------------
  $dh = toy_dh
  $bot_x25519 = x25519_private_pem

  # ---------------------------------------------------------------------------------------------
  # Check scripts, run as root on the desktop. Each prints one HB: marker, and stops at the first problem.
  # ---------------------------------------------------------------------------------------------
  def enter_dir(n)
    "D=#{dir(n)}\n[ -d \"$D\" ] || { echo HB:NODIR; exit 0; }\ncd \"$D\"\n"
  end

  def need_files(*files)
    files.map { |f| "[ -f #{f} ] || { echo HB:NO_#{f.tr('.', '_').upcase}; exit 0; }\n" }.join
  end

  # key.priv must be an unencrypted RSA private key, key.pub its public half
  KEYPAIR_CHECK = <<~SH
    openssl rsa -in key.priv -passin pass: -check -noout >/dev/null 2>&1 || { echo HB:BADPRIV; exit 0; }
    openssl rsa -pubin -in key.pub -noout >/dev/null 2>&1 || { echo HB:BADPUB; exit 0; }
    [ "$(openssl pkey -in key.priv -passin pass: -pubout 2>/dev/null)" = "$(openssl pkey -pubin -in key.pub 2>/dev/null)" ] || { echo HB:MISMATCH; exit 0; }
  SH

  # RSA-decrypts $1 with key.priv into $1.pkcs1 and $1.oaep (the student may have used either padding).
  # Don't trust pkeyutl's exit status: with implicit rejection a wrong key or padding "succeeds" with random bytes.
  RSA_DECRYPT = <<~SH
    rsa_decrypt() {
      openssl pkeyutl -decrypt -inkey key.priv -passin pass: -in "$1" -out "$2.pkcs1" 2>/dev/null
      openssl pkeyutl -decrypt -inkey key.priv -passin pass: -pkeyopt rsa_padding_mode:oaep -in "$1" -out "$2.oaep" 2>/dev/null
    }
  SH

  $check6 = enter_dir(6) + need_files('key.priv', 'key.pub') + KEYPAIR_CHECK + "echo HB:PASS\n"

  $check7 = enter_dir(7) + need_files('key.priv', 'key.pub') + KEYPAIR_CHECK + need_files('message.enc') + RSA_DECRYPT + <<~SH
    t=$(mktemp); rsa_decrypt message.enc "$t"
    r=HB:BADDECRYPT
    for f in "$t.pkcs1" "$t.oaep"; do
      [ -f "$f" ] || continue
      grep -qF '#{$msg7}' "$f" 2>/dev/null && [ "$r" = HB:BADDECRYPT ] && r=HB:WRONGMSG
      [ "$(cat "$f")" = "#{$msg7}" ] && r=HB:PASS
    done
    rm -f "$t" "$t.pkcs1" "$t.oaep"
    echo $r
  SH

  $check8 = enter_dir(8) + need_files('key.pub', 'message.txt', 'message.sig') + <<~SH
    [ "$(cat message.txt)" = "#{$msg8}" ] || { echo HB:WRONGTEXT; exit 0; }
    openssl dgst -sha256 -verify key.pub -signature message.sig message.txt 2>/dev/null | grep -q 'Verified OK' || { echo HB:BADSIG; exit 0; }
    echo HB:PASS
  SH

  $check9 = enter_dir(9) + need_files('key.priv', 'report.txt', 'report.enc', 'aes.key.enc') + RSA_DECRYPT + <<~SH
    [ "$(stat -c %s report.txt)" -ge 1000 ] || { echo HB:SMALL; exit 0; }
    t=$(mktemp); rsa_decrypt aes.key.enc "$t"
    r=HB:BADKEY
    for f in "$t.pkcs1" "$t.oaep"; do
      [ -s "$f" ] || continue
      if openssl enc -d -aes-256-cbc -pbkdf2 -in report.enc -pass file:"$f" 2>/dev/null | cmp -s - report.txt; then r=HB:PASS
      elif [ "$r" = HB:BADKEY ] && ! LC_ALL=C grep -q '[^[:print:][:space:]]' "$f"; then r=HB:BADAES; fi
    done
    rm -f "$t" "$t.pkcs1" "$t.oaep"
    [ $r = HB:PASS ] || { echo $r; exit 0; }
    [ -e aes.key ] && { echo HB:KEYLEFT; exit 0; }
    echo HB:PASS
  SH

  $check10 = enter_dir(10) + need_files('root.crt', 'inter.crt', 'leaf.crt') + <<~SH
    openssl verify -CAfile root.crt root.crt >/dev/null 2>&1 || { echo HB:ROOTNOTSELF; exit 0; }
    openssl x509 -in inter.crt -noout -text 2>/dev/null | grep -q 'CA:TRUE' || { echo HB:INTERNOTCA; exit 0; }
    openssl verify -CAfile root.crt inter.crt >/dev/null 2>&1 || { echo HB:INTERNOTSIGNED; exit 0; }
    openssl x509 -in leaf.crt -noout -text 2>/dev/null | grep -qF '#{$leaf_name}' || { echo HB:WRONGNAME; exit 0; }
    openssl verify -CAfile root.crt leaf.crt >/dev/null 2>&1 && { echo HB:DIRECT; exit 0; }
    openssl verify -CAfile root.crt -untrusted inter.crt leaf.crt >/dev/null 2>&1 || { echo HB:BADCHAIN; exit 0; }
    echo HB:PASS
  SH

  # Challenges 11 and 12 share these files; placing them again is harmless (same content)
  $place11 = "[ -d #{$H} ] || { echo HB:NOHOME; exit 0; }\nmkdir -p #{dir(11)}; chown #{$main_user}: #{dir(11)}\n" +
             write_file_script("#{dir(11)}/#{$root_file}", $ca[:root_pem], $main_user) +
             write_file_script("#{dir(11)}/#{$inter_file}", $ca[:inter_pem], $main_user) +
             "echo HB:PLACED\n"

  # Challenge 14: the first 'ready' leaves the bot's public key; later ones check the student's shared secret
  $check14 = "[ -d #{$H} ] || { echo HB:NOHOME; exit 0; }\nmkdir -p #{dir(14)}; chown #{$main_user}: #{dir(14)}\ncd #{dir(14)}\n" +
             "k=$(mktemp)\necho #{Base64.strict_encode64($bot_x25519)} | base64 -d > \"$k\"\n" + <<~SH
    if [ ! -f bot.pub ]; then
      openssl pkey -in "$k" -pubout -out bot.pub 2>/dev/null; chown #{$main_user}: bot.pub; rm -f "$k"
      echo HB:PLACED; exit 0
    fi
    [ -f my.pub ] || { rm -f "$k"; echo HB:NO_MY_PUB; exit 0; }
    [ -f shared.bin ] || { rm -f "$k"; echo HB:NO_SHARED_BIN; exit 0; }
    openssl pkey -pubin -in my.pub -noout -text 2>/dev/null | grep -q X25519 || { rm -f "$k"; echo HB:BADMYPUB; exit 0; }
    openssl pkeyutl -derive -inkey "$k" -peerkey my.pub -out "$k.s" 2>/dev/null
    rm -f "$k"
    cmp -s "$k.s" shared.bin || { rm -f "$k.s"; echo HB:WRONGSECRET; exit 0; }
    rm -f "$k.s"
    echo HB:PASS
  SH

  def no_file(file, n, hint)
    "<condition>\n\t\t\t<output_matches>HB:NO_#{file.tr('.', '_').upcase}\\b</output_matches>\n\t\t\t<message>I can't find #{file} in #{dir(n)}. #{hint}</message>\n\t\t</condition>"
  end

  def get_binding
    binding
  end
-%>
<?xml version="1.0"?>

<hackerbot
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.github/cliffe/SecGen/hackerbot">

	<name>Hackerbot</name>

	<AIML_chatbot_rules>config/AIML</AIML_chatbot_rules>

	<!--Method for gaining shell access, can be overwritten per-attack-->
	<get_shell>ssh -i /opt/hackerbot/keys/id_rsa -oStrictHostKeyChecking=no root@{{chat_ip_address}} /bin/bash</get_shell>

	<messages>
		<show_attack_numbers />

		<greeting>Public-key cryptography today. Work through the lab sheet and I'll check your work as you go. I'll cough up some flags if you get it right.</greeting>

		<!--Must provide alternatives for each message-->
		<say_ready>Let me know when you are 'ready', if you want to move on to another challenge, say 'next', or 'previous' and I'll move things along.</say_ready>
		<say_ready>When you are ready, simply say 'ready'.</say_ready>
		<say_ready>'Ready'?</say_ready>
		<next>Ok, I'll do what I can to move things along...</next>
		<next>Moving things along to the next challenge...</next>
		<next>Ok, next challenge...</next>
		<previous>Ok, I'll do what I can to back things up...</previous>
		<previous>Ok, previous challenge...</previous>
		<previous>Ok, backing up.</previous>
		<goto>Ok, skipping it along.</goto>
		<goto>Let me see what I can do to goto that challenge.</goto>
		<last_attack>That was the last challenge. Well done.</last_attack>
		<last_attack>That was the last challenge. Game over?</last_attack>
		<first_attack>You are back to the beginning!</first_attack>
		<first_attack>This is where it all began.</first_attack>
		<getting_shell>Ok. Taking a look...</getting_shell>
		<getting_shell>Checking...</getting_shell>
		<getting_shell>Here we go...</getting_shell>
		<got_shell>I'm on your system.</got_shell>
		<got_shell>Connected.</got_shell>
		<repeat>Let me know when you are 'ready', if you want to move on to another challenge, say 'next', or 'previous' and I'll move things along.</repeat>
		<repeat>Say 'ready', 'next', or 'previous'.</repeat>

		<!--Single responses:-->
		<help>I am waiting for you to say 'ready', 'next', 'previous', 'list', 'goto *X*', or 'answer *X*'</help>
		<say_answer>Say "answer X".</say_answer>
		<no_quiz>There is no question to answer</no_quiz>
		<correct_answer>Correct</correct_answer>
		<incorrect_answer>Incorrect</incorrect_answer>
		<invalid>That's not possible.</invalid>
		<non_answer>Wouldn't you like to know.</non_answer>

		<!--can be overwritten per-attack-->
		<shell_fail_message>Oh no. I couldn't get on to your desktop VM to check your work. Is it running?</shell_fail_message>
	</messages>

	<!-- ===================================================================================== -->
	<!-- 1-5: RSA by hand (answer in chat)                                                     -->
	<!-- ===================================================================================== -->

	<attack>
		<pre_shell>echo 'OK'</pre_shell>
		<get_shell>false</get_shell>
		<post_command></post_command>
		<suppress_command_output_feedback/>

		<prompt>Choosing e: p = <%= $k1[:p] %>, q = <%= $k1[:q] %>. Which of these could be the public exponent e: <%= $e1[:candidates].join(', ') %>? Answer with every valid value, smallest first, separated by spaces.</prompt>

		<condition>
			<output_matches>OK</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<condition>
			<output_matches>ok</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<else_condition>
			<message>Over to you.</message>
			<trigger_quiz />
		</else_condition>
		<quiz>
			<question>Which values could be e? (valid values only, smallest first, separated by spaces)</question>
			<answer><%= $e1[:valid].join('[ ,]+') %></answer>
			<correct_answer_response> :) <%= $flags.pop %></correct_answer_response>
			<trigger_next_attack>true</trigger_next_attack>
		</quiz>
	</attack>

	<attack>
		<pre_shell>echo 'OK'</pre_shell>
		<get_shell>false</get_shell>
		<post_command></post_command>
		<suppress_command_output_feedback/>

		<prompt>Finding d: p = <%= $k2[:p] %>, q = <%= $k2[:q] %>, e = <%= $k2[:e] %>. Work out the private exponent d.</prompt>

		<condition>
			<output_matches>OK</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<condition>
			<output_matches>ok</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<else_condition>
			<message>Over to you.</message>
			<trigger_quiz />
		</else_condition>
		<quiz>
			<question>What is d?</question>
			<answer><%= $k2[:d] %></answer>
			<correct_answer_response> :) <%= $flags.pop %></correct_answer_response>
			<trigger_next_attack>true</trigger_next_attack>
		</quiz>
	</attack>

	<attack>
		<pre_shell>echo 'OK'</pre_shell>
		<get_shell>false</get_shell>
		<post_command></post_command>
		<suppress_command_output_feedback/>

		<prompt>Encrypting: encrypt the message m = <%= $m3 %> with the public key e = <%= $k3[:e] %>, N = <%= $k3[:n] %>.</prompt>

		<condition>
			<output_matches>OK</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<condition>
			<output_matches>ok</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<else_condition>
			<message>Over to you.</message>
			<trigger_quiz />
		</else_condition>
		<quiz>
			<question>What is the ciphertext c?</question>
			<answer><%= $c3 %></answer>
			<correct_answer_response> :) <%= $flags.pop %></correct_answer_response>
			<trigger_next_attack>true</trigger_next_attack>
		</quiz>
	</attack>

	<attack>
		<pre_shell>echo 'OK'</pre_shell>
		<get_shell>false</get_shell>
		<post_command></post_command>
		<suppress_command_output_feedback/>

		<prompt>Decrypting: decrypt the ciphertext c = <%= $c4 %>. You know p = <%= $k4[:p] %>, q = <%= $k4[:q] %>, e = <%= $k4[:e] %>, so work out d first.</prompt>

		<condition>
			<output_matches>OK</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<condition>
			<output_matches>ok</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<else_condition>
			<message>Over to you.</message>
			<trigger_quiz />
		</else_condition>
		<quiz>
			<question>What is the message m?</question>
			<answer><%= $m4 %></answer>
			<correct_answer_response> :) <%= $flags.pop %></correct_answer_response>
			<trigger_next_attack>true</trigger_next_attack>
		</quiz>
	</attack>

	<attack>
		<pre_shell>echo 'OK'</pre_shell>
		<get_shell>false</get_shell>
		<post_command></post_command>
		<suppress_command_output_feedback/>

		<prompt>A secret word: each number is one character, encrypted with textbook RSA. Decrypt it with the private key d = <%= $k5[:d] %>, N = <%= $k5[:n] %>: <%= $ct5 %></prompt>

		<condition>
			<output_matches>OK</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<condition>
			<output_matches>ok</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<else_condition>
			<message>Over to you.</message>
			<trigger_quiz />
		</else_condition>
		<quiz>
			<question>What is the word?</question>
			<answer><%= Regexp.escape($word) %></answer>
			<correct_answer_response> :) <%= $flags.pop %></correct_answer_response>
			<trigger_next_attack>true</trigger_next_attack>
		</quiz>
	</attack>

	<!-- ===================================================================================== -->
	<!-- 6-9: RSA with OpenSSL (checked on the desktop)                                         -->
	<!-- ===================================================================================== -->

	<attack>
		<prompt>Key pair: create an RSA key pair in <%= dir(6) %>, with the private key in key.priv and the public key in key.pub.</prompt>
		<post_command><%= on_desktop($check6) %></post_command>
		<suppress_command_output_feedback/>
		<condition>
			<output_matches>HB:NODIR\b</output_matches>
			<message>I can't find <%= dir(6) %>. Create it first (mkdir), then make your keys inside it.</message>
		</condition>
		<%= no_file('key.priv', 6, 'Save your private key with that exact name.') %>
		<%= no_file('key.pub', 6, 'Export the public key from your private key with openssl rsa -pubout.') %>
		<condition>
			<output_matches>HB:BADPRIV\b</output_matches>
			<message>key.priv isn't an RSA private key I can read. If you protected it with a passphrase, make one without a passphrase for this challenge.</message>
		</condition>
		<condition>
			<output_matches>HB:BADPUB\b</output_matches>
			<message>key.pub isn't an RSA public key. Did you save the private key under that name by mistake?</message>
		</condition>
		<condition>
			<output_matches>HB:MISMATCH\b</output_matches>
			<message>key.pub isn't the public half of key.priv. Export it again from key.priv.</message>
		</condition>
		<condition>
			<output_matches>HB:PASS\b</output_matches>
			<message>Well done :) <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<else_condition>
			<message>Something was not quite right... say 'ready' to try again.</message>
		</else_condition>
	</attack>

	<attack>
		<prompt>Encrypt a message: in <%= dir(7) %>, create a new RSA key pair (key.priv and key.pub), then encrypt the text <%= $msg7 %> with the public key and save the result as message.enc.</prompt>
		<post_command><%= on_desktop($check7) %></post_command>
		<suppress_command_output_feedback/>
		<condition>
			<output_matches>HB:NODIR\b</output_matches>
			<message>I can't find <%= dir(7) %>. Create it first (mkdir), then work inside it.</message>
		</condition>
		<%= no_file('key.priv', 7, 'Generate a new private key with that exact name.') %>
		<%= no_file('key.pub', 7, 'Export the public key from your private key with openssl rsa -pubout.') %>
		<condition>
			<output_matches>HB:BADPRIV\b</output_matches>
			<message>key.priv isn't an RSA private key I can read (without a passphrase).</message>
		</condition>
		<condition>
			<output_matches>HB:BADPUB\b</output_matches>
			<message>key.pub isn't an RSA public key.</message>
		</condition>
		<condition>
			<output_matches>HB:MISMATCH\b</output_matches>
			<message>key.pub isn't the public half of key.priv. Export it again from key.priv.</message>
		</condition>
		<%= no_file('message.enc', 7, 'Encrypt the text with openssl pkeyutl -encrypt and write the output to message.enc.') %>
		<condition>
			<output_matches>HB:BADDECRYPT\b</output_matches>
			<message>I couldn't decrypt message.enc with key.priv. Did you encrypt it with this directory's key.pub (and -pubin)?</message>
		</condition>
		<condition>
			<output_matches>HB:WRONGMSG\b</output_matches>
			<message>message.enc decrypts, but not to <%= $msg7 %>. Put exactly that text (no quotes) in a file and encrypt the file.</message>
		</condition>
		<condition>
			<output_matches>HB:PASS\b</output_matches>
			<message>Well done :) <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<else_condition>
			<message>Something was not quite right... say 'ready' to try again.</message>
		</else_condition>
	</attack>

	<attack>
		<prompt>Sign a message: in <%= dir(8) %>, put the text <%= $msg8 %> in message.txt, sign it with your RSA private key using SHA-256, save the signature as message.sig, and put your public key there as key.pub.</prompt>
		<post_command><%= on_desktop($check8) %></post_command>
		<suppress_command_output_feedback/>
		<condition>
			<output_matches>HB:NODIR\b</output_matches>
			<message>I can't find <%= dir(8) %>. Create it first (mkdir), then work inside it.</message>
		</condition>
		<%= no_file('key.pub', 8, 'I need your public key to check the signature: copy or export it there as key.pub.') %>
		<%= no_file('message.txt', 8, "Put the text #{$msg8} in it.") %>
		<%= no_file('message.sig', 8, 'Sign message.txt with openssl dgst -sha256 -sign and save the signature as message.sig.') %>
		<condition>
			<output_matches>HB:WRONGTEXT\b</output_matches>
			<message>message.txt should contain exactly <%= $msg8 %> (no quotes).</message>
		</condition>
		<condition>
			<output_matches>HB:BADSIG\b</output_matches>
			<message>The signature doesn't verify against key.pub. Did you sign message.txt after its final edit, with the private half of key.pub, using -sha256?</message>
		</condition>
		<condition>
			<output_matches>HB:PASS\b</output_matches>
			<message>Signature verified. Well done :) <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<else_condition>
			<message>Something was not quite right... say 'ready' to try again.</message>
		</else_condition>
	</attack>

	<attack>
		<prompt>(Optional) Hybrid encryption: in <%= dir(9) %>, encrypt report.txt (at least 1000 bytes) with AES (aes-256-cbc, -pbkdf2) into report.enc, using a random key file aes.key. Encrypt aes.key with your RSA public key into aes.key.enc, leave key.priv there so I can unwrap it, then delete aes.key.</prompt>
		<post_command><%= on_desktop($check9) %></post_command>
		<suppress_command_output_feedback/>
		<condition>
			<output_matches>HB:NODIR\b</output_matches>
			<message>I can't find <%= dir(9) %>. Create it first (mkdir), then work inside it.</message>
		</condition>
		<%= no_file('key.priv', 9, 'Put an RSA private key there (copy one from an earlier challenge, or make a new one).') %>
		<%= no_file('report.txt', 9, 'Keep the original report.txt so I can compare it with what I decrypt.') %>
		<%= no_file('report.enc', 9, 'Encrypt report.txt with openssl enc -aes-256-cbc -pbkdf2 and the key in aes.key.') %>
		<%= no_file('aes.key.enc', 9, 'Encrypt aes.key with your RSA public key (openssl pkeyutl -encrypt).') %>
		<condition>
			<output_matches>HB:SMALL\b</output_matches>
			<message>report.txt needs to be at least 1000 bytes: too big for RSA to encrypt directly, which is the point.</message>
		</condition>
		<condition>
			<output_matches>HB:BADKEY\b</output_matches>
			<message>I couldn't decrypt aes.key.enc with key.priv. Encrypt aes.key with the public half of the key.priv in this directory.</message>
		</condition>
		<condition>
			<output_matches>HB:BADAES\b</output_matches>
			<message>I unwrapped the AES key, but report.enc didn't decrypt to report.txt with it. Use openssl enc -aes-256-cbc -pbkdf2 -pass file:aes.key exactly as on the lab sheet.</message>
		</condition>
		<condition>
			<output_matches>HB:KEYLEFT\b</output_matches>
			<message>It all decrypts, but aes.key is still sitting next to the encrypted file. Anyone who can read the directory can read the report. Delete aes.key, then say 'ready'.</message>
		</condition>
		<condition>
			<output_matches>HB:PASS\b</output_matches>
			<message>Unwrapped the key, decrypted the report. Well done :) <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<else_condition>
			<message>Something was not quite right... say 'ready' to try again.</message>
		</else_condition>
	</attack>

	<!-- ===================================================================================== -->
	<!-- 10-12: chains of trust                                                                -->
	<!-- ===================================================================================== -->

	<attack>
		<prompt>Chain of trust: in <%= dir(10) %>, make root.crt (a self-signed root CA), inter.crt (an intermediate CA signed by the root) and leaf.crt (a certificate for <%= $leaf_name %>, signed by the intermediate).</prompt>
		<post_command><%= on_desktop($check10) %></post_command>
		<suppress_command_output_feedback/>
		<condition>
			<output_matches>HB:NODIR\b</output_matches>
			<message>I can't find <%= dir(10) %>. Create it first (mkdir), then work inside it.</message>
		</condition>
		<%= no_file('root.crt', 10, 'Make the self-signed root certificate with openssl req -x509.') %>
		<%= no_file('inter.crt', 10, 'Sign the intermediate CA certificate with the root key (openssl x509 -req -CA root.crt).') %>
		<%= no_file('leaf.crt', 10, 'Sign the leaf certificate with the intermediate key (openssl x509 -req -CA inter.crt).') %>
		<condition>
			<output_matches>HB:ROOTNOTSELF\b</output_matches>
			<message>root.crt isn't a self-signed CA certificate. Make it with openssl req -x509.</message>
		</condition>
		<condition>
			<output_matches>HB:INTERNOTCA\b</output_matches>
			<message>inter.crt isn't marked as a CA (basicConstraints CA:TRUE), so nothing it signs will be trusted. Sign it again with the ca.ext extensions file from the lab sheet.</message>
		</condition>
		<condition>
			<output_matches>HB:INTERNOTSIGNED\b</output_matches>
			<message>inter.crt wasn't signed by root.crt's key.</message>
		</condition>
		<condition>
			<output_matches>HB:WRONGNAME\b</output_matches>
			<message>leaf.crt isn't for <%= $leaf_name %>. Use that name as the certificate's CN (and in its subjectAltName).</message>
		</condition>
		<condition>
			<output_matches>HB:DIRECT\b</output_matches>
			<message>leaf.crt was signed straight by the root. Sign it with the intermediate (-CA inter.crt -CAkey with the intermediate's key).</message>
		</condition>
		<condition>
			<output_matches>HB:BADCHAIN\b</output_matches>
			<message>openssl verify doesn't accept the chain root.crt, inter.crt, leaf.crt. Run the verify command from the lab sheet to see why.</message>
		</condition>
		<condition>
			<output_matches>HB:PASS\b</output_matches>
			<message>Root, intermediate, leaf: the chain verifies. Well done :) <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<else_condition>
			<message>Something was not quite right... say 'ready' to try again.</message>
		</else_condition>
	</attack>

	<attack>
		<prompt>Block a CA by its key: say 'ready' and I'll put a root CA certificate (<%= $root_file %>) and an intermediate CA certificate (<%= $inter_file %>) in <%= dir(11) %>. Then tell me the intermediate's SPKI hash: the SHA-256 hash of its public key.</prompt>
		<post_command><%= on_desktop($place11) %></post_command>
		<suppress_command_output_feedback/>
		<condition>
			<output_matches>HB:NOHOME\b</output_matches>
			<message>I couldn't find <%= $H %> on your desktop VM.</message>
		</condition>
		<condition>
			<output_matches>HB:PLACED\b</output_matches>
			<message>The certificates are in <%= dir(11) %>.</message>
			<trigger_quiz/>
		</condition>
		<else_condition>
			<message>Something went wrong putting the files in place... say 'ready' to try again.</message>
		</else_condition>
		<quiz>
			<question>What is the SHA-256 hash of the intermediate CA's public key (SPKI), in hex or base64?</question>
			<answer><%= $ca[:spki_hex] %>(?:\s+-)?|<%= Regexp.escape($ca[:spki_b64]) %></answer>
			<correct_answer_response> :) That is the value Chrome put on its block list for each eMudhra intermediate. <%= $flags.pop %></correct_answer_response>
			<trigger_next_attack>true</trigger_next_attack>
		</quiz>
	</attack>

	<attack>
		<prompt>Brute-force a CA key: the intermediate CA in <%= dir(11) %> (<%= $inter_file %>) came out of a broken key-generation process, and its private key is a small whole number. Say 'ready' (I'll put the files back if they're missing), find the number, and tell me.</prompt>
		<post_command><%= on_desktop($place11) %></post_command>
		<suppress_command_output_feedback/>
		<condition>
			<output_matches>HB:NOHOME\b</output_matches>
			<message>I couldn't find <%= $H %> on your desktop VM.</message>
		</condition>
		<condition>
			<output_matches>HB:PLACED\b</output_matches>
			<message>The certificates are in <%= dir(11) %>. Start counting.</message>
			<trigger_quiz/>
		</condition>
		<else_condition>
			<message>Something went wrong putting the files in place... say 'ready' to try again.</message>
		</else_condition>
		<quiz>
			<question>What is the intermediate CA's private key?</question>
			<answer><%= $weak_k %></answer>
			<correct_answer_response> :) With that number you could sign a certificate for any website, and every browser that trusts the root would accept it. <%= $flags.pop %></correct_answer_response>
			<trigger_next_attack>true</trigger_next_attack>
		</quiz>
	</attack>

	<!-- ===================================================================================== -->
	<!-- 13-14: key exchange                                                                   -->
	<!-- ===================================================================================== -->

	<attack>
		<pre_shell>echo 'OK'</pre_shell>
		<get_shell>false</get_shell>
		<post_command></post_command>
		<suppress_command_output_feedback/>

		<prompt>Diffie-Hellman: we agree on p = <%= $dh[:p] %> and g = <%= $dh[:g] %>. Your private value is a = <%= $dh[:a] %>. My public value is B = <%= $dh[:B] %>. Work out your public value A and our shared secret.</prompt>

		<condition>
			<output_matches>OK</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<condition>
			<output_matches>ok</output_matches>
			<message>Over to you.</message>
			<trigger_quiz/>
		</condition>
		<else_condition>
			<message>Over to you.</message>
			<trigger_quiz />
		</else_condition>
		<quiz>
			<question>What are A and the shared secret? (both numbers, A first, separated by a space)</question>
			<answer><%= $dh[:A] %>[ ,]+<%= $dh[:s] %></answer>
			<correct_answer_response> :) <%= $flags.pop %></correct_answer_response>
			<trigger_next_attack>true</trigger_next_attack>
		</quiz>
	</attack>

	<attack>
		<prompt>(Optional) X25519: say 'ready' and I'll put my X25519 public key in <%= dir(14) %>/bot.pub. Make your own X25519 key pair there (my.key and my.pub), derive our shared secret into shared.bin, then say 'ready' again.</prompt>
		<post_command><%= on_desktop($check14) %></post_command>
		<suppress_command_output_feedback/>
		<condition>
			<output_matches>HB:NOHOME\b</output_matches>
			<message>I couldn't find <%= $H %> on your desktop VM.</message>
		</condition>
		<condition>
			<output_matches>HB:PLACED\b</output_matches>
			<message>My public key is in <%= dir(14) %>/bot.pub. Make your key pair, derive the shared secret into shared.bin, then say 'ready'.</message>
		</condition>
		<%= no_file('my.pub', 14, 'Export your X25519 public key there as my.pub (openssl pkey -pubout).') %>
		<%= no_file('shared.bin', 14, 'Derive the shared secret with openssl pkeyutl -derive and save it as shared.bin.') %>
		<condition>
			<output_matches>HB:BADMYPUB\b</output_matches>
			<message>my.pub isn't an X25519 public key. Generate the key with openssl genpkey -algorithm X25519.</message>
		</condition>
		<condition>
			<output_matches>HB:WRONGSECRET\b</output_matches>
			<message>I get a different shared secret from my private key and your my.pub. Derive it with your my.key as -inkey and my bot.pub as -peerkey, and make sure my.pub comes from my.key.</message>
		</condition>
		<condition>
			<output_matches>HB:PASS\b</output_matches>
			<message>We both got the same secret without ever sending it. Well done :) <%= $flags.pop %></message>
		</condition>
		<else_condition>
			<message>Something was not quite right... say 'ready' to try again.</message>
		</else_condition>
	</attack>
</hackerbot>
