<%
  # The full backup -> step 3 -> differential1 -> attack -> restore-the-first-notes tasks of the backups lab
  # (hackerbot_config/backups/templates/lab.xml.erb), using its checks: same helpers and messages, cut down to
  # the one change step this exercise has. Keep the two in step when changing either.
  # $bk_first is the attack number of the first task here (set by lab.xml.erb), used in the 'goto' hints.
  require 'shellwords'
  require 'base64'

  # SECONDUSER's files, which is what gets backed up ($files is the first user's, used by other challenges)
  $bk_files = $second_account['leaked_filenames'].to_a
  $bk_files = ['myfile', 'afile', 'filee', 'thefile'] if $bk_files.empty?

  $bk_first ||= 1
  $bk_n = { full: $bk_first, step3: $bk_first + 1, diff1: $bk_first + 2, attack: $bk_first + 3, notes: $bk_first + 4 }

  $server_ip = $backup_server_ip
  $H = "/home/#{$main_user}"           # YOURUSER's home on the backup_server (backups go here)
  $S = "/home/#{$second_user}"         # SECONDUSER's home on the desktop (what is backed up)
  $full  = "#{$H}/remote-rsync-full-backup"
  $diff1 = "#{$H}/remote-rsync-differential1"

  # The "SECONDUSER makes changes" step. Contents and mtime are fixed at build time, so applying it is
  # idempotent: "goto" + "ready" puts SECONDUSER's files back exactly as they were at that step.
  $first_notes = SecureRandom.hex(2)
  $hidden_flag = 'not_a_flag'
  $steps = [3]
  $step_file = { 3 => 'personal_secrets/flag' }
  $step_content = { 3 => $hidden_flag }
  $notes = { 3 => ["Note to self: drink more water #{$first_notes}"] }
  $log2 = { 3 => ['Beep boop beep'] }
  t0 = Time.now.to_i - (Time.now.to_i % 3600)
  $mtime = { 3 => t0 + 600 }
  $step_label = { 3 => 'changes-from-step-3' }

  # Every attack runs one pre_shell on the hackerbot_server (get_shell false); scripts are shipped to the
  # target base64-encoded (no quoting/XML escaping problems) and run with bash.
  $ssh = 'ssh -i /opt/hackerbot/keys/id_rsa -oStrictHostKeyChecking=no -oBatchMode=yes'
  $desktop = 'root@{{chat_ip_address}}'
  $backup = "root@#{$server_ip}"
  $stash = "/root/.hb_backups_lab/originals-#{$second_user}.tgz"
  # Set when the attack deletes SECONDUSER's files, cleared by the change step. With only one change step, the
  # notes on the desktop straight after it *are* the first backed-up version, so without this the last task
  # could be passed by skipping the attack and the restore.
  $wiped = "/root/.hb_backups_lab/wiped-#{$second_user}"

  def q(s)
    Shellwords.escape(s)
  end

  # ssh client warnings (OpenSSH 10's post-quantum warning) would otherwise show up in the FYI output
  $nowarn = "| grep -v '^\\*\\* '"

  # Our scripts always exit 0, so a non-zero ssh exit means we never got there: print UNREACHABLE
  def on_host(host, script)
    "(echo #{Base64.strict_encode64(script)} | base64 -d | #{$ssh} #{host} bash -s 2>&1; r=$?; " \
    "[ $r = 0 ] || echo \"UNREACHABLE (ssh exit $r)\") #{$nowarn}"
  end

  def xml(s)
    s.encode(xml: :text)
  end

  # A bash function that checks one backup and prints one line per item:
  #   OK <label> | MISSING <label> | UNEXPECTED <label> | NODIR <path>, then RESULT PASS|RESULT FAIL.
  # stderr is discarded, so random names in paths can never leak into what the conditions match.
  def check_fn(fname, root, items, tag: '', structure: true)
    r = "#{root}/#{$second_user}"
    out = ["#{fname}() {", '  f=0']
    if structure
      top = ($bk_files.map { |p| "[ -e #{q(root + '/' + p)} ]" } + ["[ -d #{q(root + '/personal_secrets')} ]"]).join(' || ')
      out << "  if #{top}; then echo '#{tag}UNEXPECTED contents-at-top'; echo '#{tag}RESULT FAIL'; return 1; fi"
      out << "  if [ ! -d #{q(r)} ]; then echo '#{tag}NODIR #{r}'; echo '#{tag}RESULT FAIL'; return 1; fi"
    end
    out << "  if [ -d #{q(r + '/' + $second_user)} ]; then echo '#{tag}UNEXPECTED nested'; f=1; fi"
    items.each do |kind, label, arg|
      case kind
      when :all_present
        t = arg.map { |p| "[ -e #{q(r + '/' + p)} ]" }.join(' && ')
        out << "  if #{t}; then echo '#{tag}OK #{label}'; else echo '#{tag}MISSING #{label}'; f=1; fi"
      when :none_present
        t = arg.map { |p| "[ -e #{q(r + '/' + p)} ]" }.join(' || ')
        out << "  if #{t}; then echo '#{tag}UNEXPECTED #{label}'; f=1; else echo '#{tag}OK #{label} (not included)'; fi"
      end
    end
    out << "  if [ $f = 0 ]; then echo '#{tag}RESULT PASS'; return 0; fi; echo '#{tag}RESULT FAIL'; return 1"
    out << '}'
    out.join("\n")
  end

  # The full backup must be taken before step 3: none of step 3's files may be in it (the change step only
  # rewinds to *after* step 3, so if it was taken later differential1 can never pick those files up).
  $step3_extra = ['notes', 'logs/log2']
  $full_items  = [[:all_present, 'original-files', $bk_files]] +
                 $steps.map { |k| [:none_present, $step_label[k], [$step_file[k]] + (k == 3 ? $step3_extra : [])] }
  $later_files = ($steps.map { |k| $step_file[k] } + $step3_extra).map { |f| "/home/#{$second_user}/#{f}" }.join(' ')
  $diff1_items = [[:none_present, 'original-files', $bk_files], [:all_present, $step_label[3], [$step_file[3]]]]

  def check_script(root, items, needs = [])
    pre = needs.map do |label, dir|
      "if [ ! -d #{q(dir + '/' + $second_user)} ]; then echo 'NEEDS #{label}'; echo 'RESULT FAIL'; exit 0; fi"
    end
    check_fn('chk', root, items) + "\n" + pre.join("\n") + "\nchk\nexit 0\n"
  end

  def stage_script(step)
    s = ["S=#{q($S)}", 'mkdir -p "$S/logs" "$S/personal_secrets"']
    $steps.each do |k|
      f = "\"$S\"/#{q($step_file[k])}"
      if k <= step
        s << "printf '%s\\n' #{q($step_content[k])} > #{f}; chown #{$second_user}:#{$second_user} #{f}; touch -d @#{$mtime[k]} #{f}"
      else
        s << "rm -f #{f}"
      end
    end
    s << "printf '%s\\n' #{$notes[step].map { |l| q(l) }.join(' ')} > \"$S/notes\""
    s << "printf '%s\\n' #{$log2[step].map { |l| q(l) }.join(' ')} > \"$S/logs/log2\""
    s << "chown #{$second_user}:#{$second_user} \"$S/notes\" \"$S/logs/log2\""
    s << "touch -d @#{$mtime[step]} \"$S/notes\" \"$S/logs/log2\""
    s << "echo STAGE-#{step}-APPLIED"
    s.join("\n") + "\n"
  end

  # On first use, stash SECONDUSER's original files on the hackerbot_server (students can't reach it);
  # every time, put the originals back, then apply the step's state.
  def stage_pre_shell(step)
    d = "#{$ssh} #{$desktop}"
    "mkdir -p #{File.dirname($stash)}; rm -f #{$wiped}; O=#{$stash}; " \
    "if [ ! -s $O ]; then #{d} 'test -d #{$S}/trade_secrets && tar -C /home -czf - #{$second_user}' > $O.tmp 2>/dev/null; " \
    "if [ -s $O.tmp ]; then mv $O.tmp $O; else rm -f $O.tmp; fi; fi; " \
    "if [ -s $O ]; then #{d} 'tar -C /home -xzf - && echo ORIGINALS-RESTORED' < $O 2>&1 #{$nowarn}; else echo ORIGINALS-UNAVAILABLE; fi; " +
    on_host($desktop, stage_script(step))
  end

  # the attack only deletes once both backups needed afterwards check out (differential1 holds the only
  # copy of the first notes, needed by the last task)
  $gate_script = [
    check_fn('chk_full', $full, $full_items, tag: '[full backup] '),
    check_fn('chk_diff1', $diff1, $diff1_items, tag: '[differential1] '),
    'g=0; chk_full || g=1; chk_diff1 || g=1',
    'if [ $g = 0 ]; then echo GATE-PASS; else echo GATE-FAIL; fi',
    'exit 0'
  ].join("\n") + "\n"
  $wipe_script = "rm -rf #{q($S)}/*; echo WIPED\n"

  $notes_script = "n=\"$(cat #{q($S + '/notes')} 2>/dev/null)\"\n" +
                  $steps.map { |k| "if [ \"$n\" = \"$(printf '%s\\n' #{$notes[k].map { |l| q(l) }.join(' ')})\" ]; then echo NOTES-STEP-#{k}; exit 0; fi" }.join("\n") +
                  "\nif [ -z \"$n\" ]; then echo NOTES-MISSING; else echo NOTES-OTHER; fi\n"

  $unreach_backup = "I couldn't connect to the backup_server (#{$server_ip}) to check -- is it running? (The FYI line shows the ssh error.) Say 'ready' again once it's up."
  $unreach_desktop = "I couldn't connect to your desktop -- is its SSH server running? (The FYI line shows the ssh error.) Say 'ready' again once it's up."

  def odd_output(where)
    ":( That's not what I expected in #{where} -- the FYI lines above show what I checked (anything MISSING or UNEXPECTED is the problem). ssh to the backup_server and have a look with ls -R."
  end
%>
	<!-- ============================== backups: full backup ============================== -->
	<attack>
		<!-- topic: Rsync-->
		<prompt>It's your job to set up remote backups for <%= $second_user %> (a user on your system). Use rsync to create a full (epoch) remote backup of /home/<%= $second_user %> from your desktop system to the backup_server, so it ends up in <%= $server_ip %>:<%= $full %>/<%= $second_user %>.</prompt>

		<pre_shell><%= xml(on_host($backup, check_script($full, $full_items))) %></pre_shell>
		<get_shell>false</get_shell>
		<condition>
			<output_matches>UNREACHABLE</output_matches>
			<message>:( <%= $unreach_backup %></message>
		</condition>
		<condition>
			<output_matches>RESULT PASS</output_matches>
			<message>:) Well done! <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<condition>
			<output_matches>UNEXPECTED contents-at-top</output_matches>
			<message>:( You copied the *contents* of /home/<%= $second_user %> straight into remote-rsync-full-backup/, instead of a <%= $second_user %>/ directory inside it. With rsync, /home/<%= $second_user %> (no trailing slash) copies the directory; /home/<%= $second_user %>/ copies only what's in it. Delete it on the backup_server and try again.</message>
		</condition>
		<condition>
			<output_matches>UNEXPECTED nested</output_matches>
			<message>:( Your backup is nested one level too deep: remote-rsync-full-backup/<%= $second_user %>/<%= $second_user %>/. Give rsync the *parent* directory (.../remote-rsync-full-backup/) as the destination -- it creates <%= $second_user %>/ inside it. Delete it on the backup_server and try again.</message>
		</condition>
		<condition>
			<output_matches>NODIR</output_matches>
			<message>:( I can't find <%= $full %>/<%= $second_user %> on the backup_server. Check the destination path. (If rsync said 'mkdir ... failed: No such file or directory', the parent directory didn't exist: rsync only creates the last directory of the destination.)</message>
		</condition>
		<condition>
			<output_matches>UNEXPECTED changes-from-step</output_matches>
			<message>:( Your full backup contains files that <%= $second_user %> only creates in the next step, so it was taken after their changes, and your differential would never pick those changes up. Going back to an earlier task won't undo this, so remove them on your desktop: sudo rm -f <%= $later_files %> -- then delete remote-rsync-full-backup (and any later backups) on the backup_server, take the full backup again, and say 'ready'.</message>
		</condition>
		<condition>
			<output_matches>MISSING original-files</output_matches>
			<message>:( Some of <%= $second_user %>'s files aren't in your backup. Did you run rsync with sudo? Some of their files are private to them, so without sudo rsync can't read everything (look for 'Permission denied' in rsync's output).</message>
		</condition>
		<else_condition>
			<message><%= odd_output("#{$full}/#{$second_user}") %></message>
		</else_condition>
	</attack>

	<!-- ============================== backups: changes (step 3) ============================== -->
	<attack>
		<prompt>The <%= $second_user %> user is about to make some changes to their files. Say 'ready' to let them.</prompt>

		<pre_shell><%= xml(stage_pre_shell(3)) %></pre_shell>
		<get_shell>false</get_shell>
		<suppress_command_output_feedback />
		<condition>
			<output_matches>UNREACHABLE</output_matches>
			<message>:( <%= $unreach_desktop %></message>
		</condition>
		<condition>
			<output_matches>STAGE-3-APPLIED</output_matches>
			<message>Ok, <%= $second_user %> has made their changes... Now take the differential backup, before saying 'ready' again. (You can always say 'goto <%= $bk_n[:step3] %>' then 'ready' to put their files back to exactly this point.)</message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<condition>
			<output_matches>Permission denied|Operation not permitted|Read-only|No route|Connection refused|timed out</output_matches>
			<message>:( Oh no. I couldn't make <%= $second_user %>'s changes on your desktop. Is it running, and are <%= $second_user %>'s files writable?</message>
		</condition>
		<else_condition>
			<message>:( I couldn't make the changes to <%= $second_user %>'s files on your desktop (unexpected result). Check the desktop is running and that /home/<%= $second_user %> exists, then say 'ready' again.</message>
		</else_condition>
	</attack>

	<!-- ============================== backups: differential1 ============================== -->
	<attack>
		<!-- topic: Rsync differential-->
		<prompt>Create a differential backup of <%= $second_user %>'s home directory on the backup_server, so it ends up in <%= $server_ip %>:<%= $diff1 %>/<%= $second_user %>/ (just the changes since the full backup).</prompt>

		<pre_shell><%= xml(on_host($backup, check_script($diff1, $diff1_items, [['full-backup', $full]]))) %></pre_shell>
		<get_shell>false</get_shell>
		<condition>
			<output_matches>UNREACHABLE</output_matches>
			<message>:( <%= $unreach_backup %></message>
		</condition>
		<condition>
			<output_matches>RESULT PASS</output_matches>
			<message>:) Well done! <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<condition>
			<output_matches>NEEDS full-backup</output_matches>
			<message>:( Your full backup (<%= $full %>/<%= $second_user %>) isn't on the backup_server, and a differential is only the changes compared with it. Say 'goto <%= $bk_n[:full] %>' and do the full backup first -- it must be taken *before* <%= $second_user %>'s changes, so then say 'goto <%= $bk_n[:step3] %>' and 'ready' again before this differential.</message>
		</condition>
		<condition>
			<output_matches>UNEXPECTED contents-at-top</output_matches>
			<message>:( You copied the *contents* of /home/<%= $second_user %> straight into remote-rsync-differential1/, instead of a <%= $second_user %>/ directory inside it. Delete it on the backup_server and try again.</message>
		</condition>
		<condition>
			<output_matches>UNEXPECTED nested</output_matches>
			<message>:( Your backup is nested one level too deep (<%= $second_user %>/<%= $second_user %>/). Delete it and try again.</message>
		</condition>
		<condition>
			<output_matches>NODIR</output_matches>
			<message>:( I can't find <%= $diff1 %>/<%= $second_user %> on the backup_server. Check the destination path.</message>
		</condition>
		<condition>
			<output_matches>UNEXPECTED original-files</output_matches>
			<message>:( Your differential backup also contains files that haven't changed since the full backup, so --compare-dest didn't match anything. Delete remote-rsync-differential1 and try again.</message>
		</condition>
		<condition>
			<output_matches>MISSING changes-from-step-3</output_matches>
			<message>:( Your differential doesn't contain the changes <%= $second_user %> made. Did you back up before saying 'ready' to let them make their changes? Say 'goto <%= $bk_n[:step3] %>' then 'ready' to make those changes, then back up again.</message>
		</condition>
		<else_condition>
			<message><%= odd_output("#{$diff1}/#{$second_user}") %></message>
		</else_condition>
	</attack>

	<!-- ============================== backups: the attack (gated) ============================== -->
	<attack>
		<!-- topic: Rsync-->
		<prompt>I am going to attack you now! (Don't worry: first I'll check that the backups you'll need afterwards are right: full and differential1.)</prompt>

		<pre_shell><%= xml("G=$( #{on_host($backup, $gate_script)} ); echo \"$G\"; case \"$G\" in *UNREACHABLE*) echo UNREACHABLE-BACKUP;; *GATE-PASS*) W=$( #{on_host($desktop, $wipe_script)} ); echo \"$W\"; if echo \"$W\" | grep -q WIPED; then mkdir -p #{File.dirname($wiped)}; touch #{$wiped}; fi;; *) echo HOLD-OFF;; esac") %></pre_shell>
		<get_shell>false</get_shell>
		<condition>
			<output_matches>UNREACHABLE-BACKUP</output_matches>
			<message>:( <%= $unreach_backup %></message>
		</condition>
		<condition>
			<output_matches>HOLD-OFF</output_matches>
			<message>:( Not yet! I only attack systems whose backups would survive it, and some of yours wouldn't. The FYI lines above say which backup ([full backup] or [differential1]) and what's MISSING or UNEXPECTED in it. Fix those backups (each task's hints apply: 'goto <%= $bk_n[:step3] %>' then 'ready' puts <%= $second_user %>'s files back to just after their changes if you need to retake differential1), then 'goto <%= $bk_n[:attack] %>' and say 'ready' again.</message>
		</condition>
		<condition>
			<output_matches>WIPED</output_matches>
			<message>I just deleted all <%= $second_user %>'s files! They don't call me Hackerbot for nothin'!</message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<condition>
			<output_matches>UNREACHABLE</output_matches>
			<message>:( Your backups look good, but <%= $unreach_desktop %></message>
		</condition>
		<else_condition>
			<message>:( That's not what I expected. The FYI lines above show what happened. Say 'ready' to try again.</message>
		</else_condition>
	</attack>

	<!-- ============================== backups: earliest notes ============================== -->
	<attack>
		<!-- topic: Rsync incremental-->
		<prompt>Restore <%= $second_user %>'s notes file to the first version of it that was backed up.</prompt>

		<pre_shell><%= xml("if [ -e #{$wiped} ]; then #{on_host($desktop, $notes_script)}; else echo NOT-ATTACKED; fi") %></pre_shell>
		<get_shell>false</get_shell>
		<condition>
			<output_matches>NOT-ATTACKED</output_matches>
			<message>:( I haven't deleted <%= $second_user %>'s files yet, so there's nothing to restore. Say 'goto <%= $bk_n[:attack] %>' and 'ready' to let me attack first (and if you've since said 'ready' at the change step, which puts their files back, attack again).</message>
		</condition>
		<condition>
			<output_matches>UNREACHABLE</output_matches>
			<message>:( <%= $unreach_desktop %></message>
		</condition>
		<condition>
			<output_matches>NOTES-STEP-3</output_matches>
			<message>:) Well done! <%= $flags.pop %></message>
			<trigger_next_attack>true</trigger_next_attack>
		</condition>
		<condition>
			<output_matches>NOTES-MISSING</output_matches>
			<message>:( /home/<%= $second_user %>/notes is missing or empty. Restore it from one of your backups.</message>
		</condition>
		<else_condition>
			<message>:( That's not a version of notes I recognise. Restore it from one of your backups.</message>
		</else_condition>
	</attack>
