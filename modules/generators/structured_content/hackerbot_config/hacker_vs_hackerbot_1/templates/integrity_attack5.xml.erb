<% $c6_path = ['/etc', '/etc/default', '/etc/security', '/etc/cron.d'].sample + "/." + SecureRandom.hex(5) %>
	<attack>
		<!-- topic: File integrity checkers. New file in /etc. ONE staged challenge: 1st ready rolls back + asks for an /etc baseline; 2nd ready plants the file + quiz. -->
		<prompt>A new file is about to be planted in /etc. Say 'ready' and I'll first get your system to a known-good state.</prompt>
		<pre_shell>ST=/root/.hb_stage; mkdir -p "$ST"; F=$ST/c6_newfile; K=/opt/hackerbot/keys/id_rsa; H=root@{{chat_ip_address}}; if [ ! -e "$F" ]; then R=$(ssh -i $K -oStrictHostKeyChecking=no $H 'rm -f <%= $c6_path %>; echo RBOK' 2>&amp;1); if echo "$R" | grep -q RBOK; then touch "$F"; echo PREPARED; else echo "$R"; fi; else R=$(ssh -i $K -oStrictHostKeyChecking=no $H 'mkdir -p <%= File.dirname($c6_path) %> 2>/dev/null; touch <%= $c6_path %>; if [ -e <%= $c6_path %> ]; then echo CREATED; fi' 2>&amp;1); if echo "$R" | grep -q CREATED; then rm -f "$F"; echo CREATED; else echo "$R"; fi; fi</pre_shell>
		<get_shell>false</get_shell>
		<suppress_command_output_feedback />
		<condition>
			<output_matches>PREPARED</output_matches>
			<message>Your system is in a known-good state. Now take a baseline set of hashes of /etc, then say 'ready' and I'll plant the file.</message>
		</condition>
		<condition>
			<output_matches>CREATED</output_matches>
			<message>A new file has appeared somewhere in /etc. Compare a fresh set of /etc hashes against your baseline to find it.</message>
			<trigger_quiz />
		</condition>
		<condition>
			<output_matches>No route to host|Connection refused|Permission denied</output_matches>
			<message>:( I couldn't reach your system.</message>
		</condition>
		<else_condition>
			<message>:( Something was not right...</message>
		</else_condition>
		<quiz>
			<question>What is the full path of the newly created file?</question>
			<answer>^<%= Regexp.escape($c6_path) %>$</answer>
			<correct_answer_response>:) <%= $flags.pop %></correct_answer_response>
			<trigger_next_attack />
		</quiz>
	</attack>
