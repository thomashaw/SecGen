# Generated by SecGen (llm_relay): relays an OpenAI-compatible LLM API to lab VMs.
# Clients use http://<this VM>:<%= @listen_port %>/api/v1/ as their base URL.
server {
    listen <%= @listen_port %>;
    server_name _;
<% @allowed_networks.each do |network| -%>
    allow <%= network %>;
<% end -%>
<% unless @allowed_networks.empty? -%>
    deny all;
<% end -%>

    # decompiled functions can be large
    client_max_body_size 8m;

    # only the endpoints an assistant needs; nothing else on the gateway (web UI, sign-up, admin) is reachable
    location ~ ^/api(/v1)?/(chat/completions|models)$ {
        proxy_pass <%= @upstream_url %>;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
<% unless @api_key.to_s.empty? -%>
        proxy_set_header Authorization "Bearer <%= @api_key %>";
<% end -%>
        # stream tokens as they arrive; slow models can take minutes to answer
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        return 403;
    }
}
