#!/bin/bash
# Generated by SecGen (llm_relay): writes /etc/nftables.conf for the relay, from the subnets on this VM.
# Usage: secgen-llm-relay-firewall [--check]   (--check: exit 1 if /etc/nftables.conf is missing or out of date)
#
#   internal subnet: the internal_network NIC's connected subnet (found by its static IP, or as the
#                    directly connected route to the upstream API when it uses DHCP)
#   lab subnets:     connected subnets of the other statically addressed NICs (the provisioning NIC uses
#                    DHCP, so it is left out; it is removed after the build anyway)
set -u
UPSTREAM_HOST='<%= @upstream_host %>'
UPSTREAM_PORT='<%= @upstream_port %>'
RELAY_PORT='<%= @listen_port %>'
INTERNAL_NETWORK='<%= @internal_network %>'
ALLOWED_NETWORKS='<%= Array(@allowed_networks).join(' ') %>'
LAB_INBOUND_PORTS='<%= Array(@lab_inbound_ports).join(' ') %>'
CONF=/etc/nftables.conf

die() { echo "secgen-llm-relay-firewall: $*" >&2; exit 2; }

# connected (kernel, scope link) IPv4 subnet of an interface
subnet_of() { ip -4 -o route show dev "$1" proto kernel scope link | awk '{print $1; exit}'; }

if [ "$INTERNAL_NETWORK" = dhcp ]; then
  route=$(ip -4 -o route get "$UPSTREAM_HOST" 2>/dev/null)
  case "$route" in
    *" via "*|"") die "no directly connected route to $UPSTREAM_HOST: is the internal network NIC up? ($route)" ;;
  esac
  INTERNAL_IF=$(echo "$route" | sed -n 's/.* dev \([^ ]*\).*/\1/p')
else
  INTERNAL_IF=$(ip -4 -o addr show | awk -v ip="$INTERNAL_NETWORK" '{split($4, a, "/"); if (a[1] == ip) {print $2; exit}}')
fi
[ -n "$INTERNAL_IF" ] || die "could not find the internal network interface ($INTERNAL_NETWORK)"
INTERNAL_NET=$(subnet_of "$INTERNAL_IF")
[ -n "$INTERNAL_NET" ] || die "no connected subnet on $INTERNAL_IF"

LAB_NETS=""
while read -r _ dev _ addr rest; do
  [ "$dev" = "$INTERNAL_IF" ] && continue
  case "$rest" in *dynamic*) continue ;; esac
  net=$(subnet_of "$dev")
  [ -n "$net" ] && [ "$net" != "$INTERNAL_NET" ] && LAB_NETS="$LAB_NETS $net"
done < <(ip -4 -o addr show scope global)
LAB_NETS=$(echo $LAB_NETS | tr ' ' '\n' | sort -u | tr '\n' ' ')
[ -n "${LAB_NETS// /}" ] || die "no statically addressed lab network found"

CLIENT_NETS=${ALLOWED_NETWORKS:-$LAB_NETS}
for p in $RELAY_PORT $UPSTREAM_PORT $LAB_INBOUND_PORTS; do
  [[ "$p" =~ ^[0-9]+$ ]] || die "invalid port '$p'"
done
set_of() { echo "{ $(echo $* | sed 's/ /, /g') }"; }

generate() {
  cat <<EOF
#!/usr/sbin/nft -f
# Generated by SecGen (llm_relay) by /usr/local/sbin/secgen-llm-relay-firewall: the relay's only firewall.
# internal network: $INTERNAL_NET on $INTERNAL_IF; lab: $LAB_NETS
flush ruleset

table inet secgen_llm_relay {
  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    ct state established,related accept
    ct state invalid drop
    udp sport 67 udp dport 68 accept comment "DHCP replies"
    ip saddr $INTERNAL_NET drop comment "nothing new from the internal network"
    ip saddr $(set_of $CLIENT_NETS) tcp dport $RELAY_PORT accept comment "the relay"
EOF
  if [ -n "${LAB_INBOUND_PORTS// /}" ]; then
    echo "    ip saddr $(set_of $LAB_NETS) tcp dport $(set_of $LAB_INBOUND_PORTS) accept comment \"lab_inbound_ports\""
  fi
  cat <<EOF
    ip saddr $(set_of $LAB_NETS) icmp type echo-request accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
  }

  chain output {
    type filter hook output priority 0; policy drop;
    oif lo accept
    ct state established,related accept
    udp sport 68 udp dport 67 accept comment "DHCP"
    ip daddr $UPSTREAM_HOST tcp dport $UPSTREAM_PORT accept comment "the upstream LLM API"
    ip daddr $(set_of $LAB_NETS) accept comment "the lab networks"
  }
}
EOF
}

NEW=$(generate)
if [ "${1:-}" = --check ]; then
  [ -f "$CONF" ] && [ "$(cat "$CONF")" = "$NEW" ] && exit 0
  exit 1
fi

printf '%s\n' "$NEW" > "$CONF.secgen"
nft -c -f "$CONF.secgen" || die "generated rules failed nft's check; left in $CONF.secgen"
mv "$CONF.secgen" "$CONF"
chmod 0755 "$CONF"
echo "secgen-llm-relay-firewall: wrote $CONF (internal $INTERNAL_NET on $INTERNAL_IF; lab $LAB_NETS)"
