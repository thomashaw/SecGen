#!/bin/sh
# Exits 0 when INetSim's own DNS service cannot run here, so inetsim-dns.service
# (dnsmasq) should answer DNS instead. Newer Net::DNS releases (1.57 on Kali,
# 2026) refuse to start Net::DNS::Nameserver in a forked process ("Attempt to
# start Net::DNS::Nameserver in a subprocess"), and INetSim forks every service.
# Debian 12's Net::DNS 1.36 has no such check, so INetSim answers DNS itself.
# This looks for the check rather than a version number.
f=$(perl -MNet::DNS::Nameserver -e 'print $INC{"Net/DNS/Nameserver.pm"}' 2>/dev/null) || exit 0
grep -q 'in a subprocess' "$f"
