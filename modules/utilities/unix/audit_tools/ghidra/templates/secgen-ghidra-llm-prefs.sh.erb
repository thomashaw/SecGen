#!/bin/bash
# Generated by SecGen (ghidra module): presets the GhidrAssist LLM providers in each user's Ghidra preferences.
# Usage: secgen-ghidra-llm-prefs [--check]   (--check: exit 1 if any preferences file needs updating)
<%
  require 'json'
  url = @llm_url.to_s
  url += '/' unless url.end_with?('/')   # GhidrAssist appends "chat/completions" directly
  providers = Array(@llm_models).reject { |m| m.to_s.empty? }.map do |model|
    { 'name' => "Spark #{model}", 'type' => 'OPENAI_PLATFORM_API', 'model' => model, 'maxTokens' => 8192,
      'url' => url, 'key' => @llm_key.to_s, 'disableTlsVerification' => false, 'bypassProxy' => true,
      'timeout' => 300 }   # smart reasons before answering, so large functions can take minutes
  end
  # java.util.Properties: backslashes must be escaped; the JSON has no newlines
  providers_line = 'GhidrAssist.APIProviders=' + providers.to_json.gsub('\\') { '\\\\' }
  selected_line = 'GhidrAssist.SelectedAPIProvider=' + (providers.first ? providers.first['name'] : '')
  sh_quote = lambda { |s| "'" + s.gsub("'") { "'\\''" } + "'" }
-%>
set -u
SETTINGS_DIR='ghidra_<%= @ghidra_version %>_PUBLIC'
PROVIDERS_LINE=<%= sh_quote.call(providers_line) %>
SELECTED_LINE=<%= sh_quote.call(selected_line) %>

# set_prefs <home> <owner>: create ~/.config/ghidra/<settings dir> (each new level owned by <owner>), set both keys
set_prefs() {
  local dir=$1 owner=$2 group part file
  group=$(id -gn "$owner")
  for part in .config ghidra "$SETTINGS_DIR"; do
    dir="$dir/$part"
    if [ ! -d "$dir" ]; then
      [ "$CHECK" = 1 ] && { NEEDS_UPDATE=1; return 0; }
      install -d -o "$owner" -g "$group" -m 0700 "$dir" || return 1
    fi
  done
  file="$dir/preferences"
  if [ "$CHECK" = 1 ]; then
    grep -qxF -- "$PROVIDERS_LINE" "$file" 2>/dev/null && grep -qxF -- "$SELECTED_LINE" "$file" || NEEDS_UPDATE=1
    return 0
  fi
  # Ghidra rewrites the whole file on save, so only these two keys are replaced; the rest is kept
  { grep -v -e '^GhidrAssist\.APIProviders=' -e '^GhidrAssist\.SelectedAPIProvider=' "$file" 2>/dev/null
    printf '%s\n%s\n' "$PROVIDERS_LINE" "$SELECTED_LINE"; } > "$file.secgen"
  mv "$file.secgen" "$file"
  chown "$owner:$group" "$file"
  chmod 0600 "$file"
}

CHECK=0
NEEDS_UPDATE=0
[ "${1:-}" = '--check' ] && CHECK=1

set_prefs /etc/skel root
# root, and every local user with a home under /home (uid 1000-59999)
while IFS=: read -r name _ uid _ _ home _; do
  if [ "$name" = root ] || { [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [[ "$home" == /home/* ]] && [ -d "$home" ]; }; then
    set_prefs "$home" "$name"
  fi
done < /etc/passwd

[ "$CHECK" = 1 ] && exit "$NEEDS_UPDATE"
exit 0
