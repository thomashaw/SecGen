<?xml version="1.0"?>

<utility xmlns="http://www.github/cliffe/SecGen/utility"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.github/cliffe/SecGen/utility">
  <name>Ghidra</name>
  <author>Z. Cliffe Schreuders</author>
  <module_license>GPLv3</module_license>
  <description>A software reverse engineering (SRE) suite of tools developed by NSA's Research Directorate in support of the Cybersecurity mission.</description>

  <type>reversing_tools</type>
  <platform>linux</platform>

  <software_license>GPLv3</software_license>

  <!-- true: replace the Debugger tool's default layout (Debian's Ghidra 11.1.2 only) with the one in
       files/debugger_layout, which the dynamic debugging lab sheet is written against -->
  <read_fact>debugger_layout</read_fact>

  <default_input into="debugger_layout">
    <value>false</value>
  </default_input>

  <conflict>
    <name>.*Debian.*Wheezy.*</name>
  </conflict>
  <conflict>
    <name>.*Debian.*Stretch.*</name>
  </conflict>
  <conflict>
    <name>.*Debian.*Buster.*</name>
  </conflict>
  <!-- kali-rolling downloads Ghidra 12.1.4 at build (openjdk-21); the 2018.3 Licensed Tools base has no JDK 21 -->
  <conflict>
    <name>Kali with Licensed Tools.*</name>
  </conflict>

  <requires>
    <type>update</type>
  </requires>
</utility>
