<?xml version="1.0"?>

<vulnerability xmlns="http://www.github/cliffe/SecGen/vulnerability"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.github/cliffe/SecGen/vulnerability">
  <name>Java JDWP Debug Agent Exposed</name>
  <author>Thomas Haw</author>
  <module_license>MIT</module_license>
  <description>A Java process started with the remote debugging agent (JDWP) listening on the
    network. The Java Debug Wire Protocol has no authentication, so anyone who can reach the
    port can attach a debugger, invoke arbitrary Java code and run shell commands as the user
    running the JVM. Here a small long-running Java service runs under systemd as an
    unprivileged service account with the agent bound to all interfaces.</description>

  <type>misc</type>
  <privilege>user_rwx</privilege>
  <access>remote</access>
  <platform>linux</platform>
  <difficulty>medium</difficulty>

  <read_fact>port</read_fact>
  <read_fact>strings_to_leak</read_fact>
  <read_fact>leaked_filenames</read_fact>
  <read_fact>unix_username</read_fact>

  <default_input into="port">
    <value>8000</value>
  </default_input>

  <default_input into="strings_to_leak">
    <generator type="message_generator"/>
  </default_input>

  <default_input into="leaked_filenames">
    <generator type="filename_generator"/>
  </default_input>

  <default_input into="unix_username">
    <value>appsvc</value>
  </default_input>

  <reference>https://docs.oracle.com/en/java/javase/17/docs/specs/jpda/jdwp/jdwp-protocol.html</reference>
  <reference>https://ioactive.com/hacking-java-debug-wire-protocol-or-how/</reference>
  <reference>https://www.rapid7.com/db/modules/exploit/multi/misc/java_jdwp_debugger/</reference>
  <software_name>JDWP</software_name>
  <software_license>GPLv2</software_license>

  <msf_module>exploit/multi/misc/java_jdwp_debugger</msf_module>
  <hint>A Java process is listening on a high port that speaks its own handshake.</hint>
  <solution>A Java process exposes the JDWP debug agent on the network, allowing arbitrary code
    execution as the service account.</solution>

  <requires>
    <type>update</type>
  </requires>
  <requires>
    <module_path>utilities/unix/languages/java</module_path>
  </requires>

  <CyBOK KA="MAT" topic="Attacks and exploitation">
    <keyword>EXPLOITATION</keyword>
    <keyword>EXPLOITATION FRAMEWORKS</keyword>
  </CyBOK>
  <CyBOK KA="SS" topic="Categories of Vulnerabilities">
    <keyword>CVEs and CWEs</keyword>
  </CyBOK>
  <CyBOK KA="SOIM" topic="PENETRATION TESTING">
    <keyword>PENETRATION TESTING - SOFTWARE TOOLS</keyword>
    <keyword>PENETRATION TESTING - ACTIVE PENETRATION</keyword>
  </CyBOK>

</vulnerability>
