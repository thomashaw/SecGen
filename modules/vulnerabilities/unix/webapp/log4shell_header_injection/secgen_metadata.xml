<?xml version="1.0"?>

<vulnerability xmlns="http://www.github/cliffe/SecGen/vulnerability"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.github/cliffe/SecGen/vulnerability">
  <name>Log4Shell JNDI Header Injection (Apache Solr)</name>
  <author>Thomas Shaw</author>
  <module_license>MIT</module_license>
  <description>
    Installs Apache Solr 8.11.0, which bundles the Log4j 2.14.1 logging
    library. Log4j evaluates JNDI lookup expressions (e.g.
    ${jndi:ldap://...}) found in logged strings, including HTTP request
    headers, allowing an unauthenticated attacker to trigger remote class
    loading and arbitrary code execution.
  </description>

  <type>http</type>
  <type>webapp</type>
  <type>in_the_wild</type>
  <privilege>user_rwx</privilege>
  <access>remote</access>
  <platform>linux</platform>
  <difficulty>medium</difficulty>

  <read_fact>strings_to_leak</read_fact>
  <read_fact>leaked_filenames</read_fact>

  <!-- flag reachable only after RCE as the solr service account -->
  <default_input into="strings_to_leak">
    <generator type="message_generator"/>
  </default_input>

  <default_input into="leaked_filenames">
    <generator type="filename_generator"/>
  </default_input>

  <!--optional vulnerability details-->
  <cve>CVE-2021-44228</cve>
  <cvss_base_score>10.0</cvss_base_score>
  <cvss_vector>AV:N/AC:L/Au:N/C:C/I:C/A:C</cvss_vector>
  <reference>https://nvd.nist.gov/vuln/detail/CVE-2021-44228</reference>
  <reference>https://github.com/vulhub/vulhub/tree/master/log4j/CVE-2021-44228</reference>
  <reference>https://github.com/rapid7/metasploit-framework/blob/master/modules/exploits/multi/http/log4shell_header_injection.rb</reference>
  <software_name>Apache Solr</software_name>
  <software_license>Apache 2.0</software_license>

  <msf_module>exploit/multi/http/log4shell_header_injection</msf_module>
  <hint>Solr logs request headers; try injecting a JNDI lookup string.</hint>
  <solution>Send a request to the Solr admin cores endpoint with a header
  (e.g. X-Api-Version) set to a JNDI LDAP lookup string pointing at an
  attacker-controlled LDAP/HTTP server serving a malicious Java class.</solution>

  <!--Cannot co-exist with other installations-->
  <conflict>
    <software_name>Apache Solr</software_name>
  </conflict>
  <requires>
    <type>update</type>
  </requires>

  <CyBOK KA="MAT" topic="Attacks and exploitation">
    <keyword>EXPLOITATION</keyword>
    <keyword>EXPLOITATION FRAMEWORKS</keyword>
  </CyBOK>
  <CyBOK KA="SS" topic="Categories of Vulnerabilities">
    <keyword>CVEs and CWEs</keyword>
  </CyBOK>
  <CyBOK KA="SOIM" topic="PENETRATION TESTING">
    <keyword>PENETRATION TESTING - SOFTWARE TOOLS</keyword>
    <keyword>PENETRATION TESTING - ACTIVE PENETRATION</keyword>
  </CyBOK>
  <CyBOK KA="WAM" topic="Server-Side Vulnerabilities and Mitigations">
    <keyword>server-side misconfiguration and vulnerable components</keyword>
  </CyBOK>

</vulnerability>
