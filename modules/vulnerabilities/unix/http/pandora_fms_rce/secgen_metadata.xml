<?xml version="1.0"?>
<vulnerability xmlns="http://www.github/cliffe/SecGen/vulnerability"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.github/cliffe/SecGen/vulnerability">

  <name>Pandora FMS 7.0NG.742 SQL Injection to Remote Code Execution</name>
  <author>smarkusfeld</author>
  <module_license>MIT</module_license>
  <description>Pandora FMS 7.0NG.742 console (monitoring suite) served by Apache and MariaDB. An unauthenticated
    SQL injection in the console (chart_generator.php session handling) allows an attacker to obtain an
    administrator session and then run operating system commands as the web server user.</description>

  <type>webapp</type>
  <type>in_the_wild</type>
  <privilege>user_rwx</privilege>
  <access>remote</access>
  <platform>linux</platform>
  <difficulty>medium</difficulty>

  <read_fact>db_password</read_fact>
  <read_fact>strings_to_leak</read_fact>
  <read_fact>leaked_filenames</read_fact>

  <default_input into="db_password">
    <generator type="weak_password_generator"/>
  </default_input>

  <!-- flag exposed after exploitation (outside the web root) -->
  <default_input into="strings_to_leak">
    <generator type="message_generator"/>
  </default_input>

  <default_input into="leaked_filenames">
    <generator type="filename_generator"/>
  </default_input>

  <cve>CVE-2021-32099</cve>
  <reference>https://nvd.nist.gov/vuln/detail/CVE-2021-32099</reference>
  <reference>https://github.com/rapid7/metasploit-framework/blob/master/modules/exploits/linux/http/pandora_fms_sqli.rb</reference>
  <software_name>Pandora FMS</software_name>
  <software_license>GNU GPLv2</software_license>

  <msf_module>exploit/linux/http/pandora_fms_sqli</msf_module>

  <requires>
    <type>update</type>
  </requires>
</vulnerability>
