# Managed by SecGen apache_verb_auth_bypass. Deliberately vulnerable.
#
# The directory is protected with <Limit GET POST>, which applies Basic Auth
# only to GET and POST (and the HEAD that Apache folds into GET). Any other
# verb — TRACE, or an arbitrary/unknown method — is left unauthenticated. The
# correct directive is <LimitExcept GET POST>, which authenticates everything
# except the listed verbs.
<Directory "<%= @protected_dir %>">
    AuthType Basic
    AuthName "<%= @auth_realm %>"
    AuthBasicProvider file
    AuthUserFile "<%= @htpasswd %>"
    <Limit GET POST>
        Require valid-user
    </Limit>
</Directory>
