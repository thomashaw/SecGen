$TTL 604800
@   IN  SOA <%= @ns_hostname %>. admin.<%= @domain %>. (
<%= @serial %>  ; Serial
604800          ; Refresh
86400           ; Retry
2419200         ; Expire
604800 )        ; Negative Cache TTL

@       IN  NS  <%= @ns_hostname %>.

<% @a_record_pairs.each do |record| -%>
  <%= record['hostname'] %>  IN  A  <%= record['ip'] %>
<% end -%>

<%= @flag_hostname %>  IN  TXT  "<%= @flag %>"