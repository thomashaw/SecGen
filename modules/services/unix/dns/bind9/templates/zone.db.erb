$TTL 604800
@   IN  SOA <%= @ns_hostname %>. admin.<%= @domain %>. (
<%= @serial %>  ; Serial
604800          ; Refresh
86400           ; Retry
2419200         ; Expire
604800 )        ; Negative Cache TTL

@       IN  NS  <%= @ns_hostname %>.

<% (@dns_record_pairs || []).each do |record| -%>
<%   type = record['type'] -%>
<%   if type == 'A' || type == 'AAAA' -%>
<%= record['hostname'] %>  IN  <%= type %>  <%= record['value'] %>
<%   elsif type == 'CNAME' -%>
<%= record['hostname'] %>  IN  CNAME  <%= record['value'] %>.
<%   elsif type == 'TXT' -%>
<%= record['hostname'] %>  IN  TXT  "<%= record['value'] %>"
<%   elsif type == 'NS' -%>
<%= record['hostname'] %>  IN  NS  <%= record['value'] %>.
<%   elsif type == 'PTR' -%>
<%= record['hostname'] %>  IN  PTR  <%= record['value'] %>.
<%   elsif type == 'MX' -%>
<%= record['hostname'] %>  IN  MX  <%= record['priority'] || '10' %>  <%= record['value'] %>.
<%   end -%>
<% end -%>

<%= @flag_hostname %>  IN  TXT  "<%= @flag %>"
