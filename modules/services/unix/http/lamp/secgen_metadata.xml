<?xml version="1.0"?>

<service xmlns="http://www.github/cliffe/SecGen/service"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.github/cliffe/SecGen/service">
  <name>LAMP Stack: Apache HTTP Server, MySQL, and PHP</name>
  <author>Connor Wilson</author>
  <author>alexggolovin</author>
  <module_license>Apache v2</module_license>
  <description>A LAMP stack. Apache and MySQL are provided by apache_stretch_compatible and
  mysql_stretch_compatible; this module enables mod_php in Apache and installs the PHP MySQL
  extension.</description>

  <type>httpd</type>
  <type>database</type>

  <platform>linux</platform>

  <reference>https://httpd.apache.org/</reference>

  <!-- lamp installs PHP via apache::mod::php; apache and mysql come from required modules -->
  <software_name>php</software_name>
  <software_license>Apache v2</software_license>
  <software_license>PHP</software_license>

  <!-- Prevent a second PHP module alongside lamp's own mod_php -->
  <conflict>
    <software_name>php</software_name>
  </conflict>

  <requires>
    <type>update</type>
  </requires>
  <requires>
    <module_path>.*apache_stretch.*</module_path>
  </requires>
  <requires>
    <module_path>.*mysql_stretch.*</module_path>
  </requires>

</service>
