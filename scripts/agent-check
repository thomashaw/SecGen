#!/usr/bin/env bash
# Exercise SecGen's QEMU Guest Agent helpers (lib/helpers/proxmox_connection.rb)
# against a running VM. Runs only harmless read-only commands in the guest.
#
# Usage: scripts/agent-check <vmid> [node]   (node defaults to --proxmox-node in the config)
# Credentials come from the SecGen options file and are never printed.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/lib/common.sh"

[[ $# -ge 1 ]] || { echo "Usage: scripts/agent-check <vmid> [node]" >&2; exit 1; }
require_conf
export SECGEN_DIR SECGEN_CONF
exec bundle exec ruby "$SECGEN_DIR/scripts/lib/agent_check.rb" "$@"
