<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: mailserver service</name>
  <author>Thomas Shaw</author>
  <description>Minimal single-VM scenario that deploys the postfix/dovecot
  mailserver service, used to exercise the module's secgen_test (SMTP and IMAP
  listening with the expected greetings) via the Proxmox QEMU Guest Agent
  testing pipeline.</description>

  <type>test</type>

  <system>
    <system_name>mailserver_testing</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="mailserver_testing"/>
    </input>

    <service module_path=".*/mailserver"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

</scenario>
