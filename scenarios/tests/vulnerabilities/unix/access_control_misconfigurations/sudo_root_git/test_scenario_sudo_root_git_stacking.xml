<?xml version="1.0"?>
<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: sudo_root_git stacked with sudo_root_awk</name>
  <author>Thomas Shaw</author>
  <description>Two sudo misconfiguration modules on one VM: both sudoers rules must survive (purge => false).</description>

  <type>test</type>

  <system>
    <system_name>sudo_root_stack_target</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <!-- awk first: sudo_root_awk still uses the default purge => true, so it
         must apply before sudo_root_git or it would empty /etc/sudoers.d. -->
    <vulnerability module_path=".*/sudo_root_awk"/>
    <vulnerability module_path=".*/sudo_root_git"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>
</scenario>
