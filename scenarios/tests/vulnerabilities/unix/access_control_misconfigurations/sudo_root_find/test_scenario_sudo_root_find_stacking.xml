<?xml version="1.0"?>
<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: sudo_root_find stacks with sudo_root_awk</name>
  <author>Thomas Shaw</author>
  <description>Two sudo misconfiguration modules on one VM: both sudoers rules must survive.</description>

  <type>test</type>

  <system>
    <system_name>sudo_root_find_stack_target</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>
<input into_datastore="IP_addresses">
  <network_ip system="sudo_root_find_stack_target"/>
</input>
    <!-- awk first: it still purges /etc/sudoers.d, so it must apply before find (purge => false) -->
    <vulnerability module_path=".*/sudo_root_awk"/>
    <vulnerability module_path=".*/sudo_root_find"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

</scenario>
