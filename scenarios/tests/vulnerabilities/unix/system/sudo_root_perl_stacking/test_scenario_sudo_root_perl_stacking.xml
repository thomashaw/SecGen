<?xml version="1.0"?>

<!-- Stacking check: sudo_root_perl and sudo_root_awk on one VM; both sudoers rules must survive. -->
<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">
  <system>
    <system_name>sudo_root_perl_stacking</system_name>
    <base name="Debian 12 Bookworm Desktop KDE"/>

    <vulnerability module_path=".*sudo_root_perl"/>
    <vulnerability module_path=".*sudo_root_awk"/>

    <network type="private_network"/>
  </system>
</scenario>
