<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: elasticsearch service</name>
  <author>Thomas Shaw</author>
  <description>Minimal single-VM scenario that deploys Elasticsearch, used to
  exercise the module's secgen_test (package, service and HTTP API on port 9200)
  via the Proxmox QEMU Guest Agent testing pipeline.</description>

  <type>test</type>

  <system>
    <system_name>elasticsearch_testing</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="elasticsearch_testing"/>
    </input>

    <input into_datastore="elasticsearch_port">
      <value>9200</value>
    </input>

    <service module_path=".*/elasticsearch">
      <input into="elasticsearch_ip">
        <datastore access="0">IP_addresses</datastore>
      </input>
      <input into="elasticsearch_port">
        <datastore access="0">elasticsearch_port</datastore>
      </input>
    </service>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

</scenario>
