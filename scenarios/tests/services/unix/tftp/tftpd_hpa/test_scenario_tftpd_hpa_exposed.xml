<?xml version="1.0"?>
<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: tftpd_hpa (exposed, uploads allowed)</name>
  <author>SecGen Pipeline</author>
  <description>address 0.0.0.0:69 and allow_create true: the attacker VM can fetch the test file, and uploads of new files are accepted.</description>

  <type>test</type>

  <system>
    <system_name>tftpd_hpa_target</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>
    <input into_datastore="IP_addresses">
      <network_ip system="tftpd_hpa_target"/>
      <network_ip system="attacker"/>
    </input>
    <service module_path=".*/tftpd_hpa">
      <input into="address"><value>0.0.0.0:69</value></input>
      <input into="allow_create"><value>true</value></input>
    </service>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>attacker</system_name>
    <base distro="Kali" name="MSF"/>
    <network type="private_network"/>
    <input into_datastore="spoiler_admin_pass_attacker">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_attacker</datastore>
      </input>
    </build>
  </system>
</scenario>
