	<!-- SYSTEM 1: testing_deb (Linux)                               -->
	<!-- =========================================================== -->
	<system>
		<system_name>testing_deb</system_name>
		<base platform="linux" distro="Debian 10" type="desktop"/>

		<input into_datastore="IP_addresses">
			<value>10.0.0.5</value>      <!-- [DS-0] used by network A -->
			<value>10.1.0.10</value>     <!-- [DS-1] used by network B -->
		</input>

		<input into_datastore="spoiler_admin_pass">
			<value>tiaspbiqe2r</value>
		</input>

		<!-- [NET-A] Static IP from datastore, vlan 1 (default VLAN 100)
             Tests: 1, 4, 11, 12, 14, 36, 37, 38, 39 -->
		<network type="private_network">
			<input into="IP_address">
				<datastore access="0">IP_addresses</datastore>
				<value>10.0.0.2</value>
			</input>
			<!-- vlan defaults to 1 -->
		</network>

		<!-- [NET-B] Static IP from datastore, explicit vlan 2 (VLAN 200)
             Tests: 2, 3, 5 -->
		<network type="private_network">
			<input into="IP_address">
				<datastore access="1">IP_addresses</datastore>
			</input>
			<input into="vlan">
				<value>2</value>
			</input>
		</network>

		<!-- [NET-C] Range on vlan 1 (same as NET-A) — auto-assigns, skips .5
             Tests: 6, 7, 8, 11, 12, 14, 36, 39 -->
