	<!-- SYSTEM 2: testing_win7_2 (Windows)                          -->
	<!-- =========================================================== -->
	<system>
		<system_name>testing_win7_2</system_name>
		<base platform="windows" distro="7"/>

		<!-- [NET-G] Static IP, vlan 1 (same subnet as NET-A/NET-C — shared VLAN)
             Tests: 37, 38, 39, 40 -->
		<network type="private_network">
			<input into="IP_address">
				<value>10.0.0.5</value>
			</input>
			<!-- vlan defaults to 1 -->
		</network>

		<!-- [NET-H] Static IP, vlan 2 (same subnet as NET-B)
             Tests: 3, 5 -->
		<network type="private_network">
			<input into="IP_address">
				<value>10.1.0.30</value>
			</input>
			<input into="vlan">
				<value>2</value>
			</input>
		</network>

		<!-- [NET-I] Static IP, vlan 4 (VLAN 400) — independent
             Tests: 20-26, 41, 42 -->
		<network type="private_network">
			<input into="IP_address">
				<value>10.3.0.7</value>
			</input>
			<input into="vlan">
				<value>4</value>
			</input>
		</network>

